	('f79ffe36-4f02-4ba8-a359-b9bd8963cbd1', 'Erica', 'Crane', 'I''m a nerd about what''s possible in education. I got to teach, learn, lead, and found transformational educational programs. I have consulted, coached, and adjuncted for inclusive leadership in education.  I co-founded and ceo in sideby and coach principal interns at ASU. I also love cheese, cats, playing outside, gravel biking, dogs, triathlon, swimming everywhere, and exploring. ', 'I taught high school for 5 years in the South Bronx, executive directed high school for 9 years in Northern California, and teach MEd and EdD students now', '{ceo,co-founder,teacher,"founding school leader",adjunct}', '{}', 'https://upffcxqiozqhdgfesmji.supabase.co/storage/v1/object/public/avatars/f79ffe36-4f02-4ba8-a359-b9bd8963cbd1-0.2526810431555122.jpg', '2025-02-07 23:58:41.078185+00', '2025-05-06 16:39:59.583919+00', '{"{\"name\": \"ceo\", \"status\": \"current\"}","{\"name\": \"co-founder\", \"status\": \"current\"}","{\"name\": \"teacher\", \"status\": \"old\"}","{\"name\": \"founding school leader\", \"status\": \"old\"}","{\"name\": \"adjunct\", \"status\": \"current\"}","{\"name\": \"consultant\", \"status\": \"active\"}","{\"name\": \"coach\", \"status\": \"active\"}"}', 'erica@sideby.ai', '{"chat_notifications": true}', NULL, NULL, 'deleted', '2025-03-14 17:05:30.567+00', true, '+12037258875', '{"sms": true, "email": true, "in_app": true}', true, NULL, '2025-04-14 14:56:54.308+00', NULL, true, NULL, NULL),
