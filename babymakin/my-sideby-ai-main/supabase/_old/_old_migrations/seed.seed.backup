	('95cbbeb7-98f4-4cea-bc8c-35801dd7ac71', '5a8ff088-2eb6-45c7-84d7-d40f066b7a20', '134609', '"[]"', '2025-05-06 19:02:40.195171+00', '2025-05-06 19:02:40.195171+00', '{"type": "SINGLE", "duration": 23, "created_at": "2025-05-06T19:02:40.118Z", "session_title": "Welcome to sideby!", "knowledgeNodes": [{"id": "22", "name": "Welcome to sideby!", "tags": [{"name": "Active"}, {"name": "ColumbiaSelkirk"}, {"name": "Leaders of Color"}]}], "manually_stored": true}'),
	('907a2340-1bdc-4643-9157-0489aca87518', '31f25266-25f6-40c6-b809-30b6e6bc2301', '134645', '"[{\"speaker\":\"11338\",\"text\":\"How you you again?\",\"startTime\":1732054741,\"endTime\":1732054745},{\"speaker\":\"11318\",\"text\":\"You again.\",\"startTime\":1732054742,\"endTime\":1732054742},{\"speaker\":\"11338\",\"text\":\"Greet your partner and then.\",\"startTime\":1732054745,\"endTime\":1732054749},{\"speaker\":\"11318\",\"text\":\"In life''s a partners Oh, you''re I''m I''m looking at you.\",\"startTime\":1732054745,\"endTime\":1732054748},{\"speaker\":\"11338\",\"text\":\"I was here first. OK, good.\",\"startTime\":1732054751,\"endTime\":1732054754},{\"speaker\":\"11318\",\"text\":\"I''ll walk away. I''ll walk away.\",\"startTime\":1732054751,\"endTime\":1732054754},{\"speaker\":\"11338\",\"text\":\"Greet your partner, then share a fun fact about yourself. It says well hi Andy, \",\"startTime\":1732054757,\"endTime\":1732054760},{\"speaker\":\"11338\",\"text\":\"good to see you again. \",\"startTime\":1732054760,\"endTime\":1732054763},{\"speaker\":\"11318\",\"text\":\"You as well.\",\"startTime\":1732054764,\"endTime\":1732054765},{\"speaker\":\"11338\",\"text\":\"A fun fact about myself is my brother is a Major League Baseball umpire and so I go to as many baseball games as I can. Yes. \",\"startTime\":1732054766,\"endTime\":1732054773},{\"speaker\":\"11318\",\"text\":\"No way.\",\"startTime\":1732054770,\"endTime\":1732054771},{\"speaker\":\"11318\",\"text\":\"Wait, which? Which baseball team? Mariners. OK is it? Do umpires work for just \",\"startTime\":1732054772,\"endTime\":1732054777},{\"speaker\":\"11338\",\"text\":\"I''m a Mariners fan. Yeah, Yep.\",\"startTime\":1732054776,\"endTime\":1732054779},{\"speaker\":\"11318\",\"text\":\"one team or they go all over the place? \",\"startTime\":1732054777,\"endTime\":1732054782},{\"speaker\":\"11338\",\"text\":\"No, they go all over the place. So he''s with four guys and he travels with those \",\"startTime\":1732054784,\"endTime\":1732054788},{\"speaker\":\"11338\",\"text\":\"four guys all year and they go everywhere. So yeah, yeah. \",\"startTime\":1732054788,\"endTime\":1732054792},{\"speaker\":\"11318\",\"text\":\"That''s cool.\",\"startTime\":1732054790,\"endTime\":1732054790},{\"speaker\":\"11318\",\"text\":\"That is cool. I''m trying to think of a fun fact.\",\"startTime\":1732054793,\"endTime\":1732054796},{\"speaker\":\"11318\",\"text\":\"I''m not that exciting. I don''t.\",\"startTime\":1732054802,\"endTime\":1732054806},{\"speaker\":\"11318\",\"text\":\"I''m trying to think.\",\"startTime\":1732054808,\"endTime\":1732054809},{\"speaker\":\"11338\",\"text\":\"Well, I guess it can actually.\",\"startTime\":1732054809,\"endTime\":1732054811},{\"speaker\":\"11318\",\"text\":\"I wasn''t born in America. I don''t know if that''s a fun fact. One second.\",\"startTime\":1732054815,\"endTime\":1732054819},{\"speaker\":\"11338\",\"text\":\"Help. There you go. That''s a fun fact. Sure. Are you in the elevator?\",\"startTime\":1732054818,\"endTime\":1732054822},{\"speaker\":\"11318\",\"text\":\"OK, I, I moved away from the elevator. I was doing this in the elevator. Shall \",\"startTime\":1732054823,\"endTime\":1732054827},{\"speaker\":\"11318\",\"text\":\"we move on to the next one and hit next? \",\"startTime\":1732054827,\"endTime\":1732054830},{\"speaker\":\"11338\",\"text\":\"OK.\",\"startTime\":1732054827,\"endTime\":1732054827},{\"speaker\":\"11338\",\"text\":\"All right, good partner ready. It says OK All right. Oh, geez. Yeah. What makes \",\"startTime\":1732054830,\"endTime\":1732054835},{\"speaker\":\"11318\",\"text\":\"OK, Oh, what makes you an effective leader?\",\"startTime\":1732054834,\"endTime\":1732054837},{\"speaker\":\"11338\",\"text\":\"me an effective leader? I think what makes me an effective leader is just the \",\"startTime\":1732054835,\"endTime\":1732054840},{\"speaker\":\"11338\",\"text\":\"relationships I''m able to build with my staff. So I think they. I make sure \",\"startTime\":1732054840,\"endTime\":1732054844},{\"speaker\":\"11338\",\"text\":\"we have. We put a table in our hallway as a roundabout because we have just \",\"startTime\":1732054844,\"endTime\":1732054849},{\"speaker\":\"11338\",\"text\":\"too many kids in our building. And so like in the mornings, yeah. So in the \",\"startTime\":1732054849,\"endTime\":1732054854},{\"speaker\":\"11338\",\"text\":\"mornings I''ll go sit at the roundabout when teachers come in and just. \",\"startTime\":1732054854,\"endTime\":1732054859},{\"speaker\":\"11318\",\"text\":\"Oh, just slow them down. Yeah, that''s nice. That''s actually smart. And then \",\"startTime\":1732054856,\"endTime\":1732054860},{\"speaker\":\"11318\",\"text\":\"you''re really present. I think presence is something that''s hard for principals \",\"startTime\":1732054860,\"endTime\":1732054864},{\"speaker\":\"11338\",\"text\":\"Say hi. I''ll stop by classrooms. And I think that just makes a difference that, \",\"startTime\":1732054862,\"endTime\":1732054865},{\"speaker\":\"11318\",\"text\":\"to do at times ''cause you get busy, you''re in your office, you''re trying to hunker down, and then pretty soon the day''s over and you''re like, oh, shoot, I haven''t been to any classrooms today. I think if I''m answering that question \",\"startTime\":1732054864,\"endTime\":1732054875},{\"speaker\":\"11338\",\"text\":\"you know, approachable, I''m available, that kind of stuff. So I think that''s \",\"startTime\":1732054865,\"endTime\":1732054868},{\"speaker\":\"11338\",\"text\":\"what helps make me an effective leader. \",\"startTime\":1732054868,\"endTime\":1732054871},{\"speaker\":\"11338\",\"text\":\"Yeah, yeah.\",\"startTime\":1732054874,\"endTime\":1732054874},{\"speaker\":\"11318\",\"text\":\"for myself, I think. \",\"startTime\":1732054875,\"endTime\":1732054879},{\"speaker\":\"11338\",\"text\":\"Yeah, yeah, yeah.\",\"startTime\":1732054882,\"endTime\":1732054883},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732054888,\"endTime\":1732054888},{\"speaker\":\"11318\",\"text\":\"One of the things that I always try to bring is like my authentic self. So I, \",\"startTime\":1732054893,\"endTime\":1732054897},{\"speaker\":\"11318\",\"text\":\"I don''t mind feeling embarrassed. I don''t mind like I just, I put myself out \",\"startTime\":1732054897,\"endTime\":1732054900},{\"speaker\":\"11318\",\"text\":\"there and it is what it is. And I always try and lead with like empathy and \",\"startTime\":1732054900,\"endTime\":1732054904},{\"speaker\":\"11338\",\"text\":\"No.\",\"startTime\":1732054902,\"endTime\":1732054902},{\"speaker\":\"11318\",\"text\":\"compassion. And so I hope that always comes through in my leadership because \",\"startTime\":1732054904,\"endTime\":1732054908},{\"speaker\":\"11318\",\"text\":\"I do have to have hard conversations sometimes. So I always want to lead with \",\"startTime\":1732054908,\"endTime\":1732054911},{\"speaker\":\"11318\",\"text\":\"that first and build that relationship and then then we can have real talk. \",\"startTime\":1732054911,\"endTime\":1732054915},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732054911,\"endTime\":1732054912},{\"speaker\":\"11318\",\"text\":\"But yeah, I''m pretty silly and goofy with my staff and they know that about me. \",\"startTime\":1732054915,\"endTime\":1732054922},{\"speaker\":\"11338\",\"text\":\"Right.\",\"startTime\":1732054920,\"endTime\":1732054920},{\"speaker\":\"11318\",\"text\":\"I mean, I''m an elementary like if I can''t be silly and goofy, I don''t know what I''m doing. \",\"startTime\":1732054925,\"endTime\":1732054928},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732054925,\"endTime\":1732054925},{\"speaker\":\"11338\",\"text\":\"No. And you got to be your authentic self, right? I mean, you got to be who \",\"startTime\":1732054929,\"endTime\":1732054932},{\"speaker\":\"11318\",\"text\":\"Yeah.\",\"startTime\":1732054932,\"endTime\":1732054932},{\"speaker\":\"11338\",\"text\":\"you are. You can''t. You got to walk the walk and talk to talk. And you know, \",\"startTime\":1732054932,\"endTime\":1732054936},{\"speaker\":\"11318\",\"text\":\"Yeah.\",\"startTime\":1732054935,\"endTime\":1732054935},{\"speaker\":\"11338\",\"text\":\"shoot, I''ve cried in staff meetings talking about my staff and my kids and stuff. \",\"startTime\":1732054936,\"endTime\":1732054939},{\"speaker\":\"11318\",\"text\":\"Yeah, say you you have to. Yep. And that shows you your vulnerability so that \",\"startTime\":1732054939,\"endTime\":1732054944},{\"speaker\":\"11338\",\"text\":\"So I mean, it''s just, I mean, that''s just who I am. Yeah. So Yep. \",\"startTime\":1732054939,\"endTime\":1732054943},{\"speaker\":\"11318\",\"text\":\"they can be vulnerable. Yeah, it''s good modeling. OK, so we hit next. \",\"startTime\":1732054944,\"endTime\":1732054949},{\"speaker\":\"11338\",\"text\":\"All right, next good makes a goal in your leadership journey. Wow.\",\"startTime\":1732054947,\"endTime\":1732054954},{\"speaker\":\"11318\",\"text\":\"Yeah, describe the next call in your leadership.\",\"startTime\":1732054954,\"endTime\":1732054957},{\"speaker\":\"11318\",\"text\":\"I mean, honestly, I think I needed this the last two days because I''ve been feeling very like I''ve, I''ve kind of lost some hope ''cause things were just so hard. And I, I teeter between like, do I want to keep going? I know that \",\"startTime\":1732054959,\"endTime\":1732054974},{\"speaker\":\"11338\",\"text\":\"Yeah, right. Yeah.\",\"startTime\":1732054972,\"endTime\":1732054974},{\"speaker\":\"11318\",\"text\":\"like five to seven-year impact is down the road. I''m in year 2 and I''m like, \",\"startTime\":1732054974,\"endTime\":1732054979},{\"speaker\":\"11318\",\"text\":\"Oh my God, am I going to last that long? So I teetered between. \",\"startTime\":1732054979,\"endTime\":1732054984},{\"speaker\":\"11318\",\"text\":\"Kind of maybe going back to teaching or doing something else in education versus staying in in like the principalship. But I think my next step is really just \",\"startTime\":1732054988,\"endTime\":1732054996},{\"speaker\":\"11318\",\"text\":\"to like just to not give up and keep going and just see what happens next year. \",\"startTime\":1732054996,\"endTime\":1732055000},{\"speaker\":\"11338\",\"text\":\"Right.\",\"startTime\":1732054998,\"endTime\":1732054999},{\"speaker\":\"11318\",\"text\":\"This will it''ll be my third year. Next year. I''ll have more systems down. The \",\"startTime\":1732055000,\"endTime\":1732055004},{\"speaker\":\"11318\",\"text\":\"staff will know me more. I''ll know them more to see if it gets a little bit \",\"startTime\":1732055004,\"endTime\":1732055008},{\"speaker\":\"11338\",\"text\":\"Yeah, yeah, yeah. No, I hear you. This is my fourth year in the building, only \",\"startTime\":1732055006,\"endTime\":1732055010},{\"speaker\":\"11318\",\"text\":\"easier. Right now it just feels really hard. Yeah. \",\"startTime\":1732055008,\"endTime\":1732055012},{\"speaker\":\"11338\",\"text\":\"my second year is the full time principal. So we''re kind of in the same spot, \",\"startTime\":1732055010,\"endTime\":1732055013},{\"speaker\":\"11338\",\"text\":\"had a lot of culture to repair from the principal that was there with got hired at the same time I did. She had a tough time. She resigned, I just took over, \",\"startTime\":1732055013,\"endTime\":1732055021},{\"speaker\":\"11318\",\"text\":\"Yeah, yeah.\",\"startTime\":1732055021,\"endTime\":1732055023},{\"speaker\":\"11338\",\"text\":\"had to repair that culture and with Michael getting Michael on board, it''s been tremendous. So. \",\"startTime\":1732055021,\"endTime\":1732055029},{\"speaker\":\"11338\",\"text\":\"So I guess my goal is to.\",\"startTime\":1732055034,\"endTime\":1732055035},{\"speaker\":\"11338\",\"text\":\"Continue I I kind of think I want to be that servant leader, right No, I''m there to help you I''m there to to grow you I''m there to support you. I''m not gonna \",\"startTime\":1732055037,\"endTime\":1732055043},{\"speaker\":\"11338\",\"text\":\"I don''t make a lot of top down decisions It''s like, you know, if something comes up and I know it''s gonna affect the ELA team Nope I go talk to the El team Hey, what do you guys think? You know that kind of stuff. So I just make sure people \",\"startTime\":1732055043,\"endTime\":1732055053},{\"speaker\":\"11318\",\"text\":\"Yeah, right. Yeah, Yep.\",\"startTime\":1732055053,\"endTime\":1732055057},{\"speaker\":\"11338\",\"text\":\"are in the know. So I guess my goal is just to continue to serve in the best \",\"startTime\":1732055053,\"endTime\":1732055057},{\"speaker\":\"11338\",\"text\":\"that I can and and just I don''t know I always do what I do. People always ask \",\"startTime\":1732055057,\"endTime\":1732055060},{\"speaker\":\"11338\",\"text\":\"me, you know, about how did you build the culture and this kind of stuff so I don''t I. \",\"startTime\":1732055060,\"endTime\":1732055066},{\"speaker\":\"11338\",\"text\":\"Just do what I do. I am who I am, right? And that''s just who I am. So that going \",\"startTime\":1732055066,\"endTime\":1732055070},{\"speaker\":\"11338\",\"text\":\"back to that authentic self, yeah. \",\"startTime\":1732055070,\"endTime\":1732055073},{\"speaker\":\"11318\",\"text\":\"Yeah, it, it comes more natural. Yeah, it comes more natural. And, and some \",\"startTime\":1732055070,\"endTime\":1732055074},{\"speaker\":\"11318\",\"text\":\"people like to your point, like the fact that you''re being vulnerable, that''s already huge. Like a lot of leaders don''t do that. And so that''s modeling for \",\"startTime\":1732055074,\"endTime\":1732055081},{\"speaker\":\"11338\",\"text\":\"No, no.\",\"startTime\":1732055081,\"endTime\":1732055082},{\"speaker\":\"11318\",\"text\":\"them. And that that in itself creates a culture. So that''s awesome. Good for \",\"startTime\":1732055081,\"endTime\":1732055085},{\"speaker\":\"11318\",\"text\":\"you. OK, next. Let''s go next. \",\"startTime\":1732055085,\"endTime\":1732055089},{\"speaker\":\"11338\",\"text\":\"Yeah, yeah.\",\"startTime\":1732055085,\"endTime\":1732055087},{\"speaker\":\"11338\",\"text\":\"Alright, next partner ready.\",\"startTime\":1732055089,\"endTime\":1732055091},{\"speaker\":\"11318\",\"text\":\"What is the strength of your school sculpture? We just talked about this.\",\"startTime\":1732055094,\"endTime\":1732055097},{\"speaker\":\"11338\",\"text\":\"What is the strength of we''ve talked about this? Yeah. Our school culture is \",\"startTime\":1732055096,\"endTime\":1732055100},{\"speaker\":\"11338\",\"text\":\"I have a building of teachers who want the best for our kids and they''re willing to do stuff. We do so much stuff in our building that I don''t plan, that I have, \",\"startTime\":1732055100,\"endTime\":1732055107},{\"speaker\":\"11338\",\"text\":\"I have no part of. I mean, there''s like, hey, we''re going to do this. I''m just \",\"startTime\":1732055107,\"endTime\":1732055111},{\"speaker\":\"11338\",\"text\":\"basically yes or no and sign the check. \",\"startTime\":1732055111,\"endTime\":1732055115},{\"speaker\":\"11318\",\"text\":\"Yeah.\",\"startTime\":1732055112,\"endTime\":1732055112},{\"speaker\":\"11318\",\"text\":\"I love that.\",\"startTime\":1732055115,\"endTime\":1732055116},{\"speaker\":\"11338\",\"text\":\"And they do it. My leadership teacher rocks. I have an elite, I have an ELA \",\"startTime\":1732055116,\"endTime\":1732055120},{\"speaker\":\"11318\",\"text\":\"Love that.\",\"startTime\":1732055119,\"endTime\":1732055120},{\"speaker\":\"11338\",\"text\":\"teacher that sent out. We''re going to do the Friday before Christmas break. \",\"startTime\":1732055120,\"endTime\":1732055124},{\"speaker\":\"11338\",\"text\":\"We''re going to blow up our schedule and do some holiday activities. She''s got \",\"startTime\":1732055124,\"endTime\":1732055127},{\"speaker\":\"11338\",\"text\":\"that organized. We do, we really do. I don''t know if Ron Clark Academy, if you''re \",\"startTime\":1732055127,\"endTime\":1732055131},{\"speaker\":\"11338\",\"text\":\"familiar with that, he does a thank all the amazing shake, which really does a lot of soft skills stuff. And so we do a lot of that. And I have another teacher \",\"startTime\":1732055131,\"endTime\":1732055138},{\"speaker\":\"11338\",\"text\":\"that organized and does all that right. And so I just, there''s so much stuff \",\"startTime\":1732055138,\"endTime\":1732055142},{\"speaker\":\"11338\",\"text\":\"that my staff just steps up. \",\"startTime\":1732055142,\"endTime\":1732055146},{\"speaker\":\"11318\",\"text\":\"Oh man, that''s so fun.\",\"startTime\":1732055144,\"endTime\":1732055145},{\"speaker\":\"11338\",\"text\":\"Do a big Halloween carnival and over half the staff stayed until 8:00 at night working in the Halloween carnival. Yeah. So. And I think that''s that''s the strength \",\"startTime\":1732055146,\"endTime\":1732055155},{\"speaker\":\"11338\",\"text\":\"of our culture is the teachers that are there. So. Yeah. \",\"startTime\":1732055155,\"endTime\":1732055159},{\"speaker\":\"11318\",\"text\":\"Yeah, Yeah, that''s awesome. I think for us, my teachers are pretty laser focused \",\"startTime\":1732055159,\"endTime\":1732055164},{\"speaker\":\"11318\",\"text\":\"on instruction. That''s that''s like our overarching glue as a school because \",\"startTime\":1732055164,\"endTime\":1732055168},{\"speaker\":\"11318\",\"text\":\"of the systems that were were there before I was even there. And so strong, \",\"startTime\":1732055168,\"endTime\":1732055173},{\"speaker\":\"11318\",\"text\":\"pretty strong structures around place lab days, things like that that could get tightened up and I will say like. \",\"startTime\":1732055173,\"endTime\":1732055183},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732055183,\"endTime\":1732055183},{\"speaker\":\"11318\",\"text\":\"Our our staff likes to be really social so they do like to see each other outside of the building. \",\"startTime\":1732055184,\"endTime\":1732055187},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732055188,\"endTime\":1732055188},{\"speaker\":\"11318\",\"text\":\"And they have nice rapport with one another. And it''s not everybody, but it''s \",\"startTime\":1732055188,\"endTime\":1732055191},{\"speaker\":\"11318\",\"text\":\"the majority which which you can feel that sense of belonging and like community in the school, which is nice, yeah. \",\"startTime\":1732055191,\"endTime\":1732055198},{\"speaker\":\"11338\",\"text\":\"Right.\",\"startTime\":1732055192,\"endTime\":1732055193},{\"speaker\":\"11338\",\"text\":\"Yeah, nice. Very good. All right, next partner is ready after your partner shares. \",\"startTime\":1732055198,\"endTime\":1732055202},{\"speaker\":\"11318\",\"text\":\"Yeah.\",\"startTime\":1732055202,\"endTime\":1732055202},{\"speaker\":\"11338\",\"text\":\"Oh, you got to share first. What is an area of work for you to in regard? \",\"startTime\":1732055202,\"endTime\":1732055207},{\"speaker\":\"11318\",\"text\":\"OK.\",\"startTime\":1732055205,\"endTime\":1732055206},{\"speaker\":\"11318\",\"text\":\"To school culture, did I lose you or still there? OK.\",\"startTime\":1732055212,\"endTime\":1732055217},{\"speaker\":\"11338\",\"text\":\"Yeah, I''m there. Yeah. So what? So yeah, I was getting a phone call. I had to \",\"startTime\":1732055217,\"endTime\":1732055220},{\"speaker\":\"11338\",\"text\":\"cancel it, so. \",\"startTime\":1732055220,\"endTime\":1732055222},{\"speaker\":\"11318\",\"text\":\"Area in regards to school culture. Oh, I so my, my building is very unionized \",\"startTime\":1732055226,\"endTime\":1732055230},{\"speaker\":\"11318\",\"text\":\"and so something that I''m always trying to push on is like, how can we do this for our students? Even though your contracted time has ended and they put in \",\"startTime\":1732055230,\"endTime\":1732055239},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732055235,\"endTime\":1732055235},{\"speaker\":\"11318\",\"text\":\"a lot of hours outside of that too sometimes, but like it''s hard for the majority of them to show up to events and things. \",\"startTime\":1732055239,\"endTime\":1732055247},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732055245,\"endTime\":1732055245},{\"speaker\":\"11318\",\"text\":\"About half, I would say 50% do pretty regularly and then the other half are kind of like I''m busy with kids. I got this other stuff I''ve I''ve hit my contracted \",\"startTime\":1732055249,\"endTime\":1732055257},{\"speaker\":\"11338\",\"text\":\"No.\",\"startTime\":1732055252,\"endTime\":1732055252},{\"speaker\":\"11318\",\"text\":\"time. So I want to work on that with my school just getting them excited and \",\"startTime\":1732055257,\"endTime\":1732055260},{\"speaker\":\"11318\",\"text\":\"like bringing kids joy. I think we''ve lost some of that. \",\"startTime\":1732055260,\"endTime\":1732055264},{\"speaker\":\"11338\",\"text\":\"Yeah, yeah. Oh, there you go. That''s funny you said that. Excited to bring kids \",\"startTime\":1732055263,\"endTime\":1732055267},{\"speaker\":\"11338\",\"text\":\"to. I actually had my union Rep came to me about two weeks ago and like the \",\"startTime\":1732055267,\"endTime\":1732055271},{\"speaker\":\"11338\",\"text\":\"complaint was we were having too much fun, too many field trips, too many assemblies, that kind of stuff. And they were like, when are we going to get back to the \",\"startTime\":1732055271,\"endTime\":1732055279},{\"speaker\":\"11318\",\"text\":\"See.\",\"startTime\":1732055278,\"endTime\":1732055279},{\"speaker\":\"11338\",\"text\":\"teaching part of it? And I was just like, OK, well, I guess. \",\"startTime\":1732055279,\"endTime\":1732055282},{\"speaker\":\"11318\",\"text\":\"Yeah, but like, kids need to experience joy, like they want to be in school. \",\"startTime\":1732055284,\"endTime\":1732055288},{\"speaker\":\"11338\",\"text\":\"So, yeah, yeah.\",\"startTime\":1732055284,\"endTime\":1732055287},{\"speaker\":\"11318\",\"text\":\"That''s like step one. And then once you hook them, then they can, you know, \",\"startTime\":1732055288,\"endTime\":1732055292},{\"speaker\":\"11318\",\"text\":\"the Sky''s the limit with their learning if they feel good about being in school. \",\"startTime\":1732055292,\"endTime\":1732055297},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732055293,\"endTime\":1732055293},{\"speaker\":\"11338\",\"text\":\"Yeah. So, yeah, so we''re trying to balance that right now. So we did have a \",\"startTime\":1732055295,\"endTime\":1732055298},{\"speaker\":\"11318\",\"text\":\"So. Oh, OK. Yeah. Yeah, exactly. \",\"startTime\":1732055297,\"endTime\":1732055301},{\"speaker\":\"11338\",\"text\":\"lot of like, ''cause we have gear ups, we had a lot of gear UP assemblies or field trips in a row and and our migrant, our migrant specialists took some kids somewhere. So it''s just kind of like we did have a bunch in a short amount \",\"startTime\":1732055298,\"endTime\":1732055307},{\"speaker\":\"11338\",\"text\":\"of time. So I understand where they''re coming from and I do try to balance that. \",\"startTime\":1732055307,\"endTime\":1732055310},{\"speaker\":\"11338\",\"text\":\"But at the same time, so yeah, it''s like, well, but if we''re getting excited about school, maybe we''ll, you know. \",\"startTime\":1732055310,\"endTime\":1732055316},{\"speaker\":\"11338\",\"text\":\"Good things will happen so.\",\"startTime\":1732055318,\"endTime\":1732055319},{\"speaker\":\"11318\",\"text\":\"Yeah, and it all comes with time. OK, I''m hitting next.\",\"startTime\":1732055320,\"endTime\":1732055324},{\"speaker\":\"11338\",\"text\":\"Yeah. All right. OK. All right. Thank you very much. I think I learned that \",\"startTime\":1732055323,\"endTime\":1732055327},{\"speaker\":\"11338\",\"text\":\"you and I are probably run our Billings probably very similarly. So I think \",\"startTime\":1732055327,\"endTime\":1732055332},{\"speaker\":\"11338\",\"text\":\"it''s, you know, just being ourselves and having fun, being goofy, being vulnerable, being available, being ready. So that''s kind of what I learned. \",\"startTime\":1732055332,\"endTime\":1732055341},{\"speaker\":\"11318\",\"text\":\"Yeah, yeah, yeah, yeah. Thank you, John. I, I think, yeah, I learned the same \",\"startTime\":1732055338,\"endTime\":1732055343},{\"speaker\":\"11318\",\"text\":\"thing. And I think I learned that like it''s OK to have joy, you know, like I \",\"startTime\":1732055343,\"endTime\":1732055348},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732055345,\"endTime\":1732055346},{\"speaker\":\"11318\",\"text\":\"think we need to bring that back because we''re, we''re going too hard the other swinging the other direction. We need to kind of like you said, find that balance. \",\"startTime\":1732055348,\"endTime\":1732055357},{\"speaker\":\"11338\",\"text\":\"Yeah.\",\"startTime\":1732055358,\"endTime\":1732055358},{\"speaker\":\"11338\",\"text\":\"Yeah, yeah.\",\"startTime\":1732055361,\"endTime\":1732055362},{\"speaker\":\"11318\",\"text\":\"Yeah. Well, thank you.\",\"startTime\":1732055363,\"endTime\":1732055365},{\"speaker\":\"11338\",\"text\":\"All right. Well, thank you. Bye. Yeah, bye.\",\"startTime\":1732055365,\"endTime\":1732055369},{\"speaker\":\"11318\",\"text\":\"See you soon. Bye.\",\"startTime\":1732055367,\"endTime\":1732055368}]"', '2025-05-06 19:02:40.495506+00', '2025-05-06 19:02:40.495506+00', '{"type": "PAIR", "duration": 632, "created_at": "2025-05-06T19:02:40.296Z", "session_title": "School Leadership: Describing the Work(BEL LSL)", "knowledgeNodes": [{"id": "1416", "name": "School Leadership: Describing the Work(BEL LSL)", "tags": [{"name": "BEL"}, {"name": "LSL"}]}], "manually_stored": true}'),
	('2a326ffe-fa75-4fc9-889f-f560a86f0dbe', '0c6c53a9-c040-411d-a09e-ba80b8419d9e', '31290', '"[]"', '2025-05-06 19:40:30.931116+00', '2025-05-06 19:40:30.931116+00', '{"type": "PAIR", "duration": 552, "created_at": "2025-05-06T19:40:30.729Z", "session_title": "Welcome to sideby!", "knowledgeNodes": [{"id": "22", "name": "Welcome to sideby!", "tags": [{"name": "Active"}, {"name": "ColumbiaSelkirk"}, {"name": "Leaders of Color"}]}], "manually_stored": true}');


