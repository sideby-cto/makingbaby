INSERT INTO "public"."upduo_transcripts" ("id", "user_id", "conversation_id", "transcript", "created_at", "updated_at", "metadata") VALUES
	('ca1ba02a-5257-41ac-94ac-8d88b183e90b', '45a4fa1a-ba74-4b76-b607-072b45ea750b', '138391', '"[{\"speaker\":\"12003\",\"text\":\"My name is Tana Bourne, I''m a secondary educator. UMM. Currently, I''m working \",\"startTime\":1746019270,\"endTime\":1746019275},{\"speaker\":\"12003\",\"text\":\"with the district to curate professional developments, integrating AI in the classrooms. In the next 90 days, it is my goal to see teachers use AI, and if \",\"startTime\":1746019275,\"endTime\":1746019284},{\"speaker\":\"12003\",\"text\":\"I serve, not only to help themselves, but to also support students. In the next \",\"startTime\":1746019284,\"endTime\":1746019289},{\"speaker\":\"12003\",\"text\":\"10 years, I hope to start my own instructional coaching. \",\"startTime\":1746019289,\"endTime\":1746019294},{\"speaker\":\"12003\",\"text\":\"My stance when it comes to teaching and learning is that everyone deserves to learn. I also believe that. \",\"startTime\":1746019325,\"endTime\":1746019332},{\"speaker\":\"12003\",\"text\":\"Teachers are pivotal in making sure that all their students get exactly what they need in their classroom. \",\"startTime\":1746019332,\"endTime\":1746019339},{\"speaker\":\"12003\",\"text\":\"Umm as a teacher, I always perfect my try to perfect my practice to give students exactly what they need to be supported in the classroom to meet the goals they need to be successful not only in my class but in the rural Rd. So in my classes \",\"startTime\":1746019341,\"endTime\":1746019352},{\"speaker\":\"12003\",\"text\":\"I implement like UMM. \",\"startTime\":1746019352,\"endTime\":1746019355},{\"speaker\":\"12003\",\"text\":\"Business Fridays or like what do I call it? I call it sorry, but basically I \",\"startTime\":1746019358,\"endTime\":1746019363},{\"speaker\":\"12003\",\"text\":\"have a segment where the students I give like a real life lesson of like there''s a budget. \",\"startTime\":1746019363,\"endTime\":1746019372},{\"speaker\":\"12003\",\"text\":\"You have to cook for the whole entire week here. The prices for groceries these \",\"startTime\":1746019374,\"endTime\":1746019379},{\"speaker\":\"12003\",\"text\":\"days, shoes for groceries you''re gonna buy to create your meals for the week. \",\"startTime\":1746019379,\"endTime\":1746019383},{\"speaker\":\"12003\",\"text\":\"Things like that. So I try to integrate things like that in my everyday curriculum \",\"startTime\":1746019385,\"endTime\":1746019390},{\"speaker\":\"12003\",\"text\":\"because that''s what kids really need to learn these days. \",\"startTime\":1746019390,\"endTime\":1746019395},{\"speaker\":\"12003\",\"text\":\"That makes me lose the time when it''s watching TV.\",\"startTime\":1746019421,\"endTime\":1746019424},{\"speaker\":\"12003\",\"text\":\"I know it''s a really bad hap hobby to have but that''s my hobby. I like watch. \",\"startTime\":1746019424,\"endTime\":1746019429},{\"speaker\":\"12003\",\"text\":\"I like been to watching shows, I like watching movies. I can get lost in time \",\"startTime\":1746019429,\"endTime\":1746019434},{\"speaker\":\"12003\",\"text\":\"watching watching the show I''m recently I binge watched. \",\"startTime\":1746019434,\"endTime\":1746019438},{\"speaker\":\"12003\",\"text\":\"The sequel, $1,000,000. It was. It''s like a, umm, reality TV game show, Uh.\",\"startTime\":1746019443,\"endTime\":1746019451},{\"speaker\":\"12003\",\"text\":\"Oh, the secret millionaire or $1,000,000 secret? Yeah, that''s what''s called \",\"startTime\":1746019452,\"endTime\":1746019455},{\"speaker\":\"12003\",\"text\":\"$1,000,000 secret. Umm, that was really good. Umm. \",\"startTime\":1746019455,\"endTime\":1746019458},{\"speaker\":\"12003\",\"text\":\"There''s only one season so then take me long to get through, maybe like 2 to 3 days. \",\"startTime\":1746019459,\"endTime\":1746019464},{\"speaker\":\"12003\",\"text\":\"And I can''t wait for to come out in this season. I''m gonna binge watch that \",\"startTime\":1746019466,\"endTime\":1746019468},{\"speaker\":\"12003\",\"text\":\"in like 2 days. \",\"startTime\":1746019468,\"endTime\":1746019470},{\"speaker\":\"12003\",\"text\":\"And I''m currently watching Equalizer and Watson. Those are like the new shows \",\"startTime\":1746019472,\"endTime\":1746019477},{\"speaker\":\"12003\",\"text\":\"that I''m watching. I also like to rewatch seasons. Recently watched all of Pretty \",\"startTime\":1746019477,\"endTime\":1746019481},{\"speaker\":\"12003\",\"text\":\"Little Liars. \",\"startTime\":1746019481,\"endTime\":1746019485},{\"speaker\":\"12003\",\"text\":\"Just because it was nostalgic and right now I''m watching $1,000,000 Matchmaker. \",\"startTime\":1746019486,\"endTime\":1746019490},{\"speaker\":\"12003\",\"text\":\"It''s like a fun thing to watch. \",\"startTime\":1746019490,\"endTime\":1746019494}]"', '2025-04-30 17:35:16.247125+00', '2025-04-30 17:35:16.247125+00', '{"type": "SINGLE", "duration": 187, "created_at": "2025-04-30T17:35:16.228Z", "session_title": "Welcome to sideby!", "knowledgeNodes": [{"id": "22", "name": "Welcome to sideby!", "tags": [{"name": "Active"}, {"name": "ColumbiaSelkirk"}, {"name": "Leaders of Color"}]}], "manually_stored": true}'),
	('d1e31515-6f63-4cca-aa53-bee5a39969a8', 'f75f7f16-84b9-41ce-b842-2a77a9dd70b8', '137781', '"[{\"speaker\":\"11955\",\"text\":\"Yeah, my I, I am a teacher of.\",\"startTime\":1742589233,\"endTime\":1742589237},{\"speaker\":\"11955\",\"text\":\"Mathematics.\",\"startTime\":1742589237,\"endTime\":1742589238},{\"speaker\":\"11955\",\"text\":\"And I''m a teacher of video production, and right now I''m teaching storytelling and video production, and that''s kind of fun. \",\"startTime\":1742589238,\"endTime\":1742589245},{\"speaker\":\"11955\",\"text\":\"What else should I say about it? Oh, school was awesome today. There''s a rally \",\"startTime\":1742589247,\"endTime\":1742589251},{\"speaker\":\"11955\",\"text\":\"and I was in the dance for Dancing Queen with all of my fellow teachers, and then we played basketball. \",\"startTime\":1742589251,\"endTime\":1742589258},{\"speaker\":\"11955\",\"text\":\"And man, I was feeling like people who think that school is not something they should send their kids to. \",\"startTime\":1742589258,\"endTime\":1742589266},{\"speaker\":\"11955\",\"text\":\"Really surprises me. Like there man, there''s so much fun to be had. People who \",\"startTime\":1742589267,\"endTime\":1742589271},{\"speaker\":\"11955\",\"text\":\"care a lot, like make cool stuff happen for your kids. \",\"startTime\":1742589271,\"endTime\":1742589275}]"', '2025-04-30 20:57:08.012773+00', '2025-04-30 20:57:08.012773+00', '{"type": "SINGLE", "duration": 54, "created_at": "2025-04-30T20:57:07.977Z", "session_title": "Welcome to sideby!", "knowledgeNodes": [{"id": "22", "name": "Welcome to sideby!", "tags": [{"name": "Active"}, {"name": "ColumbiaSelkirk"}, {"name": "Leaders of Color"}]}], "manually_stored": true}'),
	('e329ea8a-59f1-45fc-a39d-fdc5f68f0a9f', '6591e553-8215-4832-843f-a15c716b5863', '137129', '"[{\"speaker\":\"11885\",\"text\":\"Me one SEC. I''m gonna switch.\",\"startTime\":1739896249,\"endTime\":1739896250},{\"speaker\":\"283\",\"text\":\"Sure. Yeah, yeah.\",\"startTime\":1739896250,\"endTime\":1739896251},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739896254,\"endTime\":1739896254},{\"speaker\":\"11885\",\"text\":\"Can you hear me now?\",\"startTime\":1739896269,\"endTime\":1739896272},{\"speaker\":\"283\",\"text\":\"Yeah. Can you hear me?\",\"startTime\":1739896271,\"endTime\":1739896273},{\"speaker\":\"11885\",\"text\":\"Yes.\",\"startTime\":1739896274,\"endTime\":1739896275},{\"speaker\":\"283\",\"text\":\"All right, there we go. So.\",\"startTime\":1739896276,\"endTime\":1739896277},{\"speaker\":\"283\",\"text\":\"This is the experience of actually meeting with a person in the app.\",\"startTime\":1739896277,\"endTime\":1739896281},{\"speaker\":\"283\",\"text\":\"And.\",\"startTime\":1739896282,\"endTime\":1739896283},{\"speaker\":\"283\",\"text\":\"You can see like, greet your partner, then press more. What''s a skill besides \",\"startTime\":1739896283,\"endTime\":1739896287},{\"speaker\":\"11885\",\"text\":\"OK.\",\"startTime\":1739896283,\"endTime\":1739896284},{\"speaker\":\"283\",\"text\":\"AI fluency that you''re working to improve right now? We''ll actually, we''ll answer \",\"startTime\":1739896287,\"endTime\":1739896290},{\"speaker\":\"283\",\"text\":\"these prompts. We''ll move through it. \",\"startTime\":1739896290,\"endTime\":1739896293},{\"speaker\":\"11885\",\"text\":\"Hmm what''s the scale besides AF fluency? Uh, right now I''m working on uh.\",\"startTime\":1739896296,\"endTime\":1739896303},{\"speaker\":\"11885\",\"text\":\"Hand eye coordination and like general dexterity. I feel like I''ve actually \",\"startTime\":1739896303,\"endTime\":1739896307},{\"speaker\":\"11885\",\"text\":\"like lost that as like a human ability like as of for some reason really recently. \",\"startTime\":1739896307,\"endTime\":1739896311},{\"speaker\":\"11885\",\"text\":\"So I''ve just I''ve just been like playing more playing more basketball. Like \",\"startTime\":1739896311,\"endTime\":1739896315},{\"speaker\":\"283\",\"text\":\"Oh yeah, yeah, I''m working on.\",\"startTime\":1739896314,\"endTime\":1739896316},{\"speaker\":\"11885\",\"text\":\"I notice I I don''t type things correctly all the time or I''m like missing characters on average by about like. \",\"startTime\":1739896315,\"endTime\":1739896323},{\"speaker\":\"11885\",\"text\":\"3rd of a centimeter. And so I need to like, I don''t know, adjust like mentally. \",\"startTime\":1739896323,\"endTime\":1739896328},{\"speaker\":\"11885\",\"text\":\"How about you?\",\"startTime\":1739896332,\"endTime\":1739896334},{\"speaker\":\"283\",\"text\":\"I''m working on bike skills because I grew up riding a bike but then was in New York City, was in places I wasn''t going to ride in the city, did some mountain biking but now I''ve been doing gravel biking so I can bike for like 70 miles. \",\"startTime\":1739896334,\"endTime\":1739896345},{\"speaker\":\"283\",\"text\":\"But the actual technical skills. \",\"startTime\":1739896345,\"endTime\":1739896348},{\"speaker\":\"11885\",\"text\":\"Mm-hmm.\",\"startTime\":1739896348,\"endTime\":1739896348},{\"speaker\":\"283\",\"text\":\"I''m like starting and stopping, just feeling really comfortable jumping a curb, like just while being clipped in. That''s what I need to keep working on. It''s \",\"startTime\":1739896349,\"endTime\":1739896356},{\"speaker\":\"11885\",\"text\":\"Oh. Mm-hmm.\",\"startTime\":1739896355,\"endTime\":1739896357},{\"speaker\":\"283\",\"text\":\"like I built the endurance, but now just those little. So it''s like, you know, \",\"startTime\":1739896356,\"endTime\":1739896359},{\"speaker\":\"283\",\"text\":\"practicing like leaning down off the bike in the yard, like I''m like playing my bikes in my yard to try to build those skills right now, Well, right now it''s snowy, but. \",\"startTime\":1739896359,\"endTime\":1739896369},{\"speaker\":\"283\",\"text\":\"When it''s not snowing, I''m doing that. Yeah. Yeah. All right.\",\"startTime\":1739896370,\"endTime\":1739896374},{\"speaker\":\"11885\",\"text\":\"Nice, cool.\",\"startTime\":1739896374,\"endTime\":1739896376},{\"speaker\":\"11885\",\"text\":\"How has AI changed your work as an educator or leader of educators so far?\",\"startTime\":1739896376,\"endTime\":1739896381},{\"speaker\":\"11885\",\"text\":\"OK so AI has changed my work as an educator in that I now have to.\",\"startTime\":1739896383,\"endTime\":1739896392},{\"speaker\":\"11885\",\"text\":\"Set an expectation, a different expectation with my students. And I also feel \",\"startTime\":1739896396,\"endTime\":1739896402},{\"speaker\":\"11885\",\"text\":\"very compelled to let others know that other educators know how I set expectations and inform and request that like request kind of that information from them. \",\"startTime\":1739896402,\"endTime\":1739896414},{\"speaker\":\"11885\",\"text\":\"Like, you know, I feel compelled to ask people how they adjust for knowing for that expectation of students using AI in their classroom, in other words. \",\"startTime\":1739896414,\"endTime\":1739896426},{\"speaker\":\"11885\",\"text\":\"They know that I know that they''re gonna use AI, right? OK, I''m, I have to say, \",\"startTime\":1739896431,\"endTime\":1739896436},{\"speaker\":\"283\",\"text\":\"Mm-hmm. Mm-hmm.\",\"startTime\":1739896435,\"endTime\":1739896441},{\"speaker\":\"11885\",\"text\":\"we we cannot address that. I''m gonna, I, I address it. I set a new expectation. \",\"startTime\":1739896436,\"endTime\":1739896442},{\"speaker\":\"11885\",\"text\":\"But that''s the way that looks in my classroom. How does it look with other people? \",\"startTime\":1739896445,\"endTime\":1739896449},{\"speaker\":\"11885\",\"text\":\"Are they just ignoring it? Am I doing the right thing? And that new dimension \",\"startTime\":1739896449,\"endTime\":1739896453},{\"speaker\":\"11885\",\"text\":\"of expectation setting, almost at like a meta level, is how it''s influencing my my work. \",\"startTime\":1739896453,\"endTime\":1739896461},{\"speaker\":\"11885\",\"text\":\"And as like a regular educator, and then I guess what I can call myself as such a leader of educators in a way. \",\"startTime\":1739896463,\"endTime\":1739896470},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739896469,\"endTime\":1739896469},{\"speaker\":\"283\",\"text\":\"Yeah, I think that''s super interesting. That''s similarly I met a, I''m at ASU \",\"startTime\":1739896471,\"endTime\":1739896475},{\"speaker\":\"11885\",\"text\":\"How are you?\",\"startTime\":1739896471,\"endTime\":1739896472},{\"speaker\":\"283\",\"text\":\"as a principal coach and then I''m also at Edgewood College, which is a local university, but in there like global Ed leadership development program, so in their masters and doctorate level. \",\"startTime\":1739896475,\"endTime\":1739896488},{\"speaker\":\"283\",\"text\":\"And their default is ban AI And I''ve, I''ve allowed to not ban AI, but like I have made a policy and it''s really, and I talk about it openly, but I can tell \",\"startTime\":1739896490,\"endTime\":1739896497},{\"speaker\":\"11885\",\"text\":\"A sick.\",\"startTime\":1739896490,\"endTime\":1739896490},{\"speaker\":\"283\",\"text\":\"students are like worry that then they''ll be known for using it if they admit to using it and they''re worried another class because the majority of their \",\"startTime\":1739896497,\"endTime\":1739896505},{\"speaker\":\"283\",\"text\":\"other classes ban it like, And so it''s this tricky thing where I''m like, I know you''re using it because I''m, I use these tools so I can tell what you''re doing here, but you''re using it poorly. I''d rather you just be open and then we can \",\"startTime\":1739896505,\"endTime\":1739896516},{\"speaker\":\"283\",\"text\":\"talk about how. \",\"startTime\":1739896516,\"endTime\":1739896520},{\"speaker\":\"11885\",\"text\":\"Yeah.\",\"startTime\":1739896519,\"endTime\":1739896520},{\"speaker\":\"283\",\"text\":\"I can clearly tell you didn''t check these sources. I can clearly tell you didn''t \",\"startTime\":1739896520,\"endTime\":1739896524},{\"speaker\":\"283\",\"text\":\"reread this part. I can clearly tell this isn''t related to your specific context \",\"startTime\":1739896524,\"endTime\":1739896528},{\"speaker\":\"283\",\"text\":\"because you just contradicted yourself and the the only way you do that is if you''re using these tools. So that''s been an interesting one to try to. I also \",\"startTime\":1739896528,\"endTime\":1739896536},{\"speaker\":\"283\",\"text\":\"respect that they''re worried because that could be used against them in an educational hearing where the academic integrity office is not clear on how they like persecute AI infractions and places that it''s not allowed. \",\"startTime\":1739896536,\"endTime\":1739896547},{\"speaker\":\"283\",\"text\":\"Because could it be used in other classes? They see they used it in this class \",\"startTime\":1739896548,\"endTime\":1739896551},{\"speaker\":\"11885\",\"text\":\"Right. Mm-hmm.\",\"startTime\":1739896549,\"endTime\":1739896551},{\"speaker\":\"283\",\"text\":\"like I, I don''t know the answer. So I I can kind of respect when students are \",\"startTime\":1739896551,\"endTime\":1739896554},{\"speaker\":\"283\",\"text\":\"like, we''re not sure here so. \",\"startTime\":1739896554,\"endTime\":1739896557},{\"speaker\":\"283\",\"text\":\"I''m trying it in my own sphere of influence to say like, this is my college, this is, I think it''s great. I think it pushes all of us to be better. How can \",\"startTime\":1739896558,\"endTime\":1739896564},{\"speaker\":\"11885\",\"text\":\"Yeah.\",\"startTime\":1739896560,\"endTime\":1739896560},{\"speaker\":\"283\",\"text\":\"we use emerging technology? It''s it''s not just AI, it''s everything. So yeah, \",\"startTime\":1739896564,\"endTime\":1739896568},{\"speaker\":\"283\",\"text\":\"it''s definitely thinking similarly. And like, how do we model it for other professors \",\"startTime\":1739896568,\"endTime\":1739896571},{\"speaker\":\"283\",\"text\":\"or work with other professors so that we can work with students as openly as possible? \",\"startTime\":1739896571,\"endTime\":1739896577},{\"speaker\":\"11885\",\"text\":\"Mm-hmm. Yeah. Any first, any strong first movers will set a precedent no matter \",\"startTime\":1739896581,\"endTime\":1739896585},{\"speaker\":\"283\",\"text\":\"Yeah, yeah.\",\"startTime\":1739896582,\"endTime\":1739896582},{\"speaker\":\"11885\",\"text\":\"what. It''s no longer, it''s not something where you can just run. You can de \",\"startTime\":1739896585,\"endTime\":1739896589},{\"speaker\":\"11885\",\"text\":\"facto just run things the way you want and expect others to not really care. \",\"startTime\":1739896589,\"endTime\":1739896594},{\"speaker\":\"11885\",\"text\":\"I think it''s, it has, there''s such novelty and urgency to relieve ourselves of the confusion surrounding how to use it in the classroom that I think as soon as someone sees it working at one place, I would, I have a strong punch. \",\"startTime\":1739896594,\"endTime\":1739896606},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739896601,\"endTime\":1739896601},{\"speaker\":\"11885\",\"text\":\"I''ll just try to, you know, copy that. \",\"startTime\":1739896606,\"endTime\":1739896610},{\"speaker\":\"283\",\"text\":\"Yeah, and then wanting them to get better. I could like one student.\",\"startTime\":1739896611,\"endTime\":1739896615},{\"speaker\":\"283\",\"text\":\"Yeah, just the stories of like these quotes don''t exist.\",\"startTime\":1739896616,\"endTime\":1739896619},{\"speaker\":\"11885\",\"text\":\"Yeah.\",\"startTime\":1739896618,\"endTime\":1739896618},{\"speaker\":\"283\",\"text\":\"You know, like, like the idea exists and the quote doesn''t exist. And now you''ve \",\"startTime\":1739896621,\"endTime\":1739896625},{\"speaker\":\"283\",\"text\":\"quoted this and then you''re fighting me on it. And then it was like, oh, realizing \",\"startTime\":1739896625,\"endTime\":1739896629},{\"speaker\":\"283\",\"text\":\"what they''ve done. But I I wasn''t trying to get them expelled. I was just like, \",\"startTime\":1739896629,\"endTime\":1739896633},{\"speaker\":\"11885\",\"text\":\"Yeah, yeah.\",\"startTime\":1739896630,\"endTime\":1739896632},{\"speaker\":\"283\",\"text\":\"hey, hey, hey, you don''t want to do this like this. So. So how do we, how do \",\"startTime\":1739896633,\"endTime\":1739896637},{\"speaker\":\"283\",\"text\":\"you actually prompt well enough to be able to get those quotes if you uploaded an article and you''re trying to pull an idea, like, I''d rather us talk about that than just throw the book. Yeah, yeah, yeah. \",\"startTime\":1739896637,\"endTime\":1739896648},{\"speaker\":\"11885\",\"text\":\"Yeah.\",\"startTime\":1739896646,\"endTime\":1739896647},{\"speaker\":\"11885\",\"text\":\"Yeah, give them good pro my my my solution is giving them better prompts or something but. \",\"startTime\":1739896648,\"endTime\":1739896653},{\"speaker\":\"11885\",\"text\":\"Alright, you''re ready.\",\"startTime\":1739896654,\"endTime\":1739896656},{\"speaker\":\"11885\",\"text\":\"Take turns. How do you think AI will change the role of learners in the future? \",\"startTime\":1739896657,\"endTime\":1739896662},{\"speaker\":\"11885\",\"text\":\"Umm, the role of learners. OK.\",\"startTime\":1739896664,\"endTime\":1739896665},{\"speaker\":\"11885\",\"text\":\"The role, I mean, I actually don''t think it will change the role of learners that much. Umm, I think they will. If if for the the question their role is \",\"startTime\":1739896670,\"endTime\":1739896678},{\"speaker\":\"283\",\"text\":\"Mm-hmm. MMM. MMM MMM.\",\"startTime\":1739896670,\"endTime\":1739896671},{\"speaker\":\"11885\",\"text\":\"that of a learner, then umm. \",\"startTime\":1739896678,\"endTime\":1739896682},{\"speaker\":\"11885\",\"text\":\"I think they''re like what is a role, right? It''s like a set of things that you \",\"startTime\":1739896685,\"endTime\":1739896688},{\"speaker\":\"11885\",\"text\":\"are like assigned to do, like for a period like as well as like set of responsibilities that they have. \",\"startTime\":1739896688,\"endTime\":1739896696},{\"speaker\":\"283\",\"text\":\"Mm-hmm. Mm-hmm. MMM, mm-hmm.\",\"startTime\":1739896689,\"endTime\":1739896693},{\"speaker\":\"11885\",\"text\":\"I think that remains largely the same. It''s the way they it will change the \",\"startTime\":1739896699,\"endTime\":1739896703},{\"speaker\":\"11885\",\"text\":\"the way they accomplish their role, but the role itself I think will remain largely fundamentally the same. \",\"startTime\":1739896703,\"endTime\":1739896711},{\"speaker\":\"283\",\"text\":\"Mm-hmm. Mm-hmm.\",\"startTime\":1739896708,\"endTime\":1739896709},{\"speaker\":\"283\",\"text\":\"Yeah, yeah, I think about like.\",\"startTime\":1739896713,\"endTime\":1739896715},{\"speaker\":\"283\",\"text\":\"Utilization of tools in ways that fulfills.\",\"startTime\":1739896716,\"endTime\":1739896720},{\"speaker\":\"283\",\"text\":\"Where you''re trying to go like role as learner is like and and the one piece that I I. \",\"startTime\":1739896722,\"endTime\":1739896727},{\"speaker\":\"11885\",\"text\":\"Uh oh, I think I''m breaking up.\",\"startTime\":1739896728,\"endTime\":1739896729},{\"speaker\":\"283\",\"text\":\"Oh, I can hear you. Can you hear me?\",\"startTime\":1739896729,\"endTime\":1739896731},{\"speaker\":\"283\",\"text\":\"I can still hear you. Can you hear me?\",\"startTime\":1739896734,\"endTime\":1739896736},{\"speaker\":\"11885\",\"text\":\"Yeah, yeah. Wait. Give me one. I''m going to move. Maybe. I think the wife will \",\"startTime\":1739896740,\"endTime\":1739896743},{\"speaker\":\"283\",\"text\":\"Yeah, sure, sure.\",\"startTime\":1739896741,\"endTime\":1739896743},{\"speaker\":\"11885\",\"text\":\"be better. Please. \",\"startTime\":1739896743,\"endTime\":1739896745},{\"speaker\":\"283\",\"text\":\"All good, Sure.\",\"startTime\":1739896745,\"endTime\":1739896747},{\"speaker\":\"11885\",\"text\":\"So I was in a telephone booth, but now I''m gonna go out into the.\",\"startTime\":1739896749,\"endTime\":1739896753},{\"speaker\":\"11885\",\"text\":\"Larger area.\",\"startTime\":1739896754,\"endTime\":1739896756},{\"speaker\":\"11885\",\"text\":\"So I''m sorry your background noise.\",\"startTime\":1739896758,\"endTime\":1739896759},{\"speaker\":\"283\",\"text\":\"That''s OK, we can make it work.\",\"startTime\":1739896759,\"endTime\":1739896761},{\"speaker\":\"283\",\"text\":\"Yeah, I was just going to say I think it''s about tools, but there''s something in. \",\"startTime\":1739896764,\"endTime\":1739896768},{\"speaker\":\"11885\",\"text\":\"OK, uh, OK, uh.\",\"startTime\":1739896765,\"endTime\":1739896767},{\"speaker\":\"283\",\"text\":\"I''m an adult who''s practiced creating and using my own voice and journaling, and I''m not saying those things can''t happen for younger people. \",\"startTime\":1739896769,\"endTime\":1739896777},{\"speaker\":\"283\",\"text\":\"But I do wonder if I didn''t have more years to play in that like critical thinking and reflection space, how will I, how would I have developed differently as a learner if I was always using my kind of AI tool? And I''m not saying don''t \",\"startTime\":1739896778,\"endTime\":1739896790},{\"speaker\":\"283\",\"text\":\"use the tools, but there''s something about like, oh, I''m honing or tweaking versus like it''s doing all the thinking for me. \",\"startTime\":1739896790,\"endTime\":1739896799},{\"speaker\":\"11885\",\"text\":\"Yeah, yeah.\",\"startTime\":1739896801,\"endTime\":1739896803},{\"speaker\":\"283\",\"text\":\"So sometimes I grapple with that for young people for like if from 10 years old on. \",\"startTime\":1739896802,\"endTime\":1739896805},{\"speaker\":\"11885\",\"text\":\"Yeah, it''s, I think it will.\",\"startTime\":1739896808,\"endTime\":1739896812},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739896808,\"endTime\":1739896808},{\"speaker\":\"11885\",\"text\":\"I think one of the biggest changes or things that will.\",\"startTime\":1739896813,\"endTime\":1739896816},{\"speaker\":\"11885\",\"text\":\"Help, but that will kind of coax everyone to go through is is self reflection sooner than later. \",\"startTime\":1739896817,\"endTime\":1739896825},{\"speaker\":\"11885\",\"text\":\"Like we like all we have asked for as students.\",\"startTime\":1739896828,\"endTime\":1739896833},{\"speaker\":\"11885\",\"text\":\"De facto.\",\"startTime\":1739896833,\"endTime\":1739896834},{\"speaker\":\"11885\",\"text\":\"I mean de jure theoretically you know, to learn the osmosis absorbed information, but de facto is to just get the solution, get the grade, you know, get this, get the get the paper and then get the money, right? That''s and the shortest \",\"startTime\":1739896835,\"endTime\":1739896848},{\"speaker\":\"11885\",\"text\":\"path possible while doing the least amount of work. \",\"startTime\":1739896848,\"endTime\":1739896852},{\"speaker\":\"11885\",\"text\":\"OK, well, what? What''s the solution to that? That we''ve been asking for a machine, \",\"startTime\":1739896854,\"endTime\":1739896858},{\"speaker\":\"11885\",\"text\":\"right, that gives us those answers so that if I do no work. \",\"startTime\":1739896858,\"endTime\":1739896863},{\"speaker\":\"11885\",\"text\":\"And get all the benefit. Congrats, now we have that.\",\"startTime\":1739896863,\"endTime\":1739896866},{\"speaker\":\"11885\",\"text\":\"Now what my students, umm, now we actually have to think, OK, well, maybe I should learn something here because that''s what I guess I just paid for, right? \",\"startTime\":1739896869,\"endTime\":1739896877},{\"speaker\":\"11885\",\"text\":\"Umm, or should I, should I just continue using it? I think that''s what a lot \",\"startTime\":1739896877,\"endTime\":1739896881},{\"speaker\":\"283\",\"text\":\"Yeah, Mm-hmm.\",\"startTime\":1739896879,\"endTime\":1739896881},{\"speaker\":\"11885\",\"text\":\"of students, what we''re going, are beginning to think about. And as a result, \",\"startTime\":1739896881,\"endTime\":1739896885},{\"speaker\":\"11885\",\"text\":\"like we''ll have to actually reflect on it like that. Like about like they can \",\"startTime\":1739896885,\"endTime\":1739896889},{\"speaker\":\"11885\",\"text\":\"get their education now on paper. Will they actually be educated? That''s a question \",\"startTime\":1739896889,\"endTime\":1739896893},{\"speaker\":\"11885\",\"text\":\"they have to answer. \",\"startTime\":1739896893,\"endTime\":1739896898},{\"speaker\":\"11885\",\"text\":\"That''s the way it''s shaping the way they think about their role, I think.\",\"startTime\":1739896906,\"endTime\":1739896908},{\"speaker\":\"283\",\"text\":\"Yeah and yeah.\",\"startTime\":1739896906,\"endTime\":1739896907},{\"speaker\":\"283\",\"text\":\"Yeah. Oh, that''s so interesting. Yep. OK.\",\"startTime\":1739896909,\"endTime\":1739896912},{\"speaker\":\"283\",\"text\":\"Next, read the challenges and choose one.\",\"startTime\":1739896916,\"endTime\":1739896919},{\"speaker\":\"11885\",\"text\":\"Set What''s your story? You''ve heard mine.\",\"startTime\":1739896923,\"endTime\":1739896926},{\"speaker\":\"283\",\"text\":\"I started moving into education, so in college I was like, I''m going to be a pediatric oncologist. My mom had cancer. I want to work with kids. I''m going \",\"startTime\":1739896928,\"endTime\":1739896937},{\"speaker\":\"283\",\"text\":\"to solve that problem. \",\"startTime\":1739896937,\"endTime\":1739896937},{\"speaker\":\"283\",\"text\":\"And then I volunteered at Sloan Kettering in New York City and saw how much the kids hated their doctors because they inflicted. So if you''re little, they \",\"startTime\":1739896937,\"endTime\":1739896946},{\"speaker\":\"283\",\"text\":\"inflict a lot of pain. They heal you. But that, like, this stuff hurts. \",\"startTime\":1739896946,\"endTime\":1739896951},{\"speaker\":\"283\",\"text\":\"So after really seeing kids like cower from doctors, I realized that wasn''t going to be where I was going to. I couldn''t, I couldn''t do that. That wasn''t \",\"startTime\":1739896952,\"endTime\":1739896960},{\"speaker\":\"283\",\"text\":\"for me. So I shifted into like, OK, we''ll be counseling with students. What \",\"startTime\":1739896960,\"endTime\":1739896964},{\"speaker\":\"283\",\"text\":\"will it be? And moved into teaching and realized too, I, I was familiar with \",\"startTime\":1739896964,\"endTime\":1739896968},{\"speaker\":\"283\",\"text\":\"schools, familiar with the format, but I didn''t love school. I just like won \",\"startTime\":1739896968,\"endTime\":1739896973},{\"speaker\":\"283\",\"text\":\"at school. I didn''t love learning yet I loved learning certain things in certain \",\"startTime\":1739896973,\"endTime\":1739896977},{\"speaker\":\"283\",\"text\":\"areas with certain teachers. \",\"startTime\":1739896977,\"endTime\":1739896981},{\"speaker\":\"283\",\"text\":\"And so then moved into this program that was in the South Bronx that was innovative, project based, New York City, Outward Bound connected. So we did a big like \",\"startTime\":1739896983,\"endTime\":1739896991},{\"speaker\":\"11885\",\"text\":\"Mm-hmm. Yeah.\",\"startTime\":1739896984,\"endTime\":1739897001},{\"speaker\":\"283\",\"text\":\"backpacking to kick off 9th grade year like all, and it just expanded my mind to what was possible in schools. Fell in love with that model and then worked \",\"startTime\":1739896991,\"endTime\":1739896998},{\"speaker\":\"283\",\"text\":\"for that organization, started that school in Northern California with that same approach. Mike was our founding math teacher. \",\"startTime\":1739896998,\"endTime\":1739897006},{\"speaker\":\"283\",\"text\":\"And really just went all in on.\",\"startTime\":1739897008,\"endTime\":1739897011},{\"speaker\":\"283\",\"text\":\"School can be.\",\"startTime\":1739897011,\"endTime\":1739897012},{\"speaker\":\"11885\",\"text\":\"Oh wow.\",\"startTime\":1739897011,\"endTime\":1739897012},{\"speaker\":\"283\",\"text\":\"Like our wildest dreams in public. They were both Republic. My California one \",\"startTime\":1739897013,\"endTime\":1739897016},{\"speaker\":\"283\",\"text\":\"was public charter, but it wasn''t funded different and all kids were open. There \",\"startTime\":1739897016,\"endTime\":1739897020},{\"speaker\":\"283\",\"text\":\"was no like application. You can''t come in. \",\"startTime\":1739897020,\"endTime\":1739897023},{\"speaker\":\"283\",\"text\":\"So seeing how I''m my story really has to do with like what''s possible in education, how can I do good but also. \",\"startTime\":1739897026,\"endTime\":1739897033},{\"speaker\":\"283\",\"text\":\"Want to do good in ways that work for me like I, I, I.\",\"startTime\":1739897033,\"endTime\":1739897035},{\"speaker\":\"283\",\"text\":\"I know doing good as a pediatric oncologist is important, but that wasn''t going to be for me. And then thinking about now like. \",\"startTime\":1739897036,\"endTime\":1739897044},{\"speaker\":\"283\",\"text\":\"As someone who was in schools for 15 years, I deeply respect that work. But \",\"startTime\":1739897044,\"endTime\":1739897048},{\"speaker\":\"283\",\"text\":\"I love being remote. I love doing kind of a variety of things, and I love. \",\"startTime\":1739897048,\"endTime\":1739897053},{\"speaker\":\"283\",\"text\":\"I respect the people who are in schools every day, but I don''t want to be in a school every day, not anymore. \",\"startTime\":1739897054,\"endTime\":1739897059},{\"speaker\":\"11885\",\"text\":\"Yeah, a lot. Yeah. I can kind of relate in that. Like, I don''t know how much \",\"startTime\":1739897060,\"endTime\":1739897064},{\"speaker\":\"11885\",\"text\":\"I think I generally like learning things as long as they''re like novel, like are new to me. \",\"startTime\":1739897064,\"endTime\":1739897072},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897068,\"endTime\":1739897068},{\"speaker\":\"11885\",\"text\":\"But like only certain via in school it was just like.\",\"startTime\":1739897074,\"endTime\":1739897076},{\"speaker\":\"11885\",\"text\":\"I mean, actually I was just a bad person in school, like in general. But yeah, \",\"startTime\":1739897077,\"endTime\":1739897082},{\"speaker\":\"11885\",\"text\":\"there were some things that a teacher, I think 1 teacher maybe made interesting and that helped and I enjoyed at least maybe not the material, but learning what he had to say. But yeah, I think on the topic of like your career. \",\"startTime\":1739897082,\"endTime\":1739897096},{\"speaker\":\"283\",\"text\":\"Mm-hmm.\",\"startTime\":1739897087,\"endTime\":1739897087},{\"speaker\":\"11885\",\"text\":\"Like, you know, wait, wait, career options. I think that''s another thing that \",\"startTime\":1739897099,\"endTime\":1739897102},{\"speaker\":\"11885\",\"text\":\"AI will help us, Will. \",\"startTime\":1739897102,\"endTime\":1739897104},{\"speaker\":\"11885\",\"text\":\"Kind of force us to reflect on is the economics of our decision, right like. \",\"startTime\":1739897105,\"endTime\":1739897109},{\"speaker\":\"11885\",\"text\":\"Now he like now.\",\"startTime\":1739897111,\"endTime\":1739897112},{\"speaker\":\"11885\",\"text\":\"That we have as much information as we can get right, at least in economics. \",\"startTime\":1739897113,\"endTime\":1739897116},{\"speaker\":\"11885\",\"text\":\"Like if there''s. \",\"startTime\":1739897116,\"endTime\":1739897118},{\"speaker\":\"11885\",\"text\":\"Open up the perfect information we can make. We have to make a decision, you \",\"startTime\":1739897119,\"endTime\":1739897123},{\"speaker\":\"11885\",\"text\":\"know, we''re not guided by the lack of information to to pick one. \",\"startTime\":1739897123,\"endTime\":1739897127},{\"speaker\":\"11885\",\"text\":\"And we''re hyper aware now of like things like, you know, what are, who do I sacrifice now that I can make this sacrifice? How do I sacrifice time for, for \",\"startTime\":1739897129,\"endTime\":1739897139},{\"speaker\":\"11885\",\"text\":\"stress and money for time, time, money for stress, things like that for. \",\"startTime\":1739897139,\"endTime\":1739897144},{\"speaker\":\"11885\",\"text\":\"Everyday things, which sounds like what you went through in a way like this versus that. \",\"startTime\":1739897146,\"endTime\":1739897150},{\"speaker\":\"283\",\"text\":\"Yeah, yeah. And figuring out what? Yeah, yeah, figuring that out.\",\"startTime\":1739897149,\"endTime\":1739897153},{\"speaker\":\"283\",\"text\":\"And wanting to.\",\"startTime\":1739897155,\"endTime\":1739897157},{\"speaker\":\"283\",\"text\":\"Create an organization where it really, if we''re, if we''re going to be engaging in work, some people don''t have to, some people don''t want to, but if we''re going to be engaging in work, I have to engage in work. I want it to be a place \",\"startTime\":1739897157,\"endTime\":1739897170},{\"speaker\":\"283\",\"text\":\"that people feel like they can go after what makes them excited about doing like learning and pieces like I''m not trying to say. \",\"startTime\":1739897170,\"endTime\":1739897178},{\"speaker\":\"11885\",\"text\":\"Yeah.\",\"startTime\":1739897170,\"endTime\":1739897171},{\"speaker\":\"283\",\"text\":\"I want everyone to love job because I get it, it''s a job, but I want to make an organization that feels like you get some flow when you get to engage in what really is the stuff of your like zone of genius or where you get excited. \",\"startTime\":1739897180,\"endTime\":1739897192},{\"speaker\":\"283\",\"text\":\"And that we''re doing something that does feel like it can do some good as well as like be sustainable and be profitable so that we''re not worried or going through that like layoff, halftime, layoff half time, like I ''cause that. \",\"startTime\":1739897192,\"endTime\":1739897205},{\"speaker\":\"283\",\"text\":\"Wellness wise is hard to.\",\"startTime\":1739897205,\"endTime\":1739897207},{\"speaker\":\"11885\",\"text\":\"MMM, yeah.\",\"startTime\":1739897205,\"endTime\":1739897208},{\"speaker\":\"283\",\"text\":\"Justifying.\",\"startTime\":1739897209,\"endTime\":1739897210},{\"speaker\":\"11885\",\"text\":\"It''s hard, yeah, but that''s a that''s a very much an economic question. Like \",\"startTime\":1739897211,\"endTime\":1739897215},{\"speaker\":\"11885\",\"text\":\"you have to make some decisions, make some sacrifices. Like I need to do this \",\"startTime\":1739897215,\"endTime\":1739897218},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897216,\"endTime\":1739897217},{\"speaker\":\"11885\",\"text\":\"now, that way that doesn''t happen later. And you know, it''s, it''s hard. \",\"startTime\":1739897218,\"endTime\":1739897222},{\"speaker\":\"283\",\"text\":\"Mm-hmm. Yeah. Yeah.\",\"startTime\":1739897224,\"endTime\":1739897226},{\"speaker\":\"283\",\"text\":\"Yeah. Is there? Yeah. What''s the problem with practice?\",\"startTime\":1739897226,\"endTime\":1739897230},{\"speaker\":\"11885\",\"text\":\"Challenge 2 is to solve a problem.\",\"startTime\":1739897227,\"endTime\":1739897229},{\"speaker\":\"11885\",\"text\":\"What''s a problem of?\",\"startTime\":1739897230,\"endTime\":1739897231},{\"speaker\":\"283\",\"text\":\"That you may be able to help me with.\",\"startTime\":1739897232,\"endTime\":1739897234},{\"speaker\":\"11885\",\"text\":\"Where''s the?\",\"startTime\":1739897234,\"endTime\":1739897235},{\"speaker\":\"283\",\"text\":\"Well, we''re talking about.\",\"startTime\":1739897235,\"endTime\":1739897237},{\"speaker\":\"11885\",\"text\":\"The problem with practice, uh, like the practice of teaching.\",\"startTime\":1739897240,\"endTime\":1739897244},{\"speaker\":\"283\",\"text\":\"Yeah. Is there something in? Yeah. Well, and it could be like in the app immediately \",\"startTime\":1739897242,\"endTime\":1739897245},{\"speaker\":\"283\",\"text\":\"knowing that, oh, she''s clunky, but is there something immediately that''s sticking out to you? Especially seeing like you''ve made a bartender matching app, you''ve \",\"startTime\":1739897245,\"endTime\":1739897253},{\"speaker\":\"283\",\"text\":\"made that like thinking about what we''re trying to do and what currently exists, knowing there''s a long list, but is there something jumping out to you right away that you''re like, oh, I, I feel like I would bring this expertise in there. \",\"startTime\":1739897253,\"endTime\":1739897264},{\"speaker\":\"11885\",\"text\":\"Yeah.\",\"startTime\":1739897260,\"endTime\":1739897260},{\"speaker\":\"11885\",\"text\":\"Yeah, like design or like fundamental kind of like like human design as much as I don''t know, like I, I. \",\"startTime\":1739897266,\"endTime\":1739897273},{\"speaker\":\"11885\",\"text\":\"Umm, but I mean this in like the least literal way. Umm, I''m like moderately \",\"startTime\":1739897277,\"endTime\":1739897281},{\"speaker\":\"11885\",\"text\":\"lazy in terms of, in terms of my thought process. Like I don''t like thinking. \",\"startTime\":1739897281,\"endTime\":1739897285},{\"speaker\":\"283\",\"text\":\"Yep. Mm-hmm.\",\"startTime\":1739897283,\"endTime\":1739897283},{\"speaker\":\"11885\",\"text\":\"I, I reserve my thinking for work. And then like after that, I don''t really \",\"startTime\":1739897285,\"endTime\":1739897289},{\"speaker\":\"11885\",\"text\":\"want to think like I, I don''t know, like I gotta, I have to like do math. I \",\"startTime\":1739897289,\"endTime\":1739897293},{\"speaker\":\"11885\",\"text\":\"like the grocery store and figure things out. Like I don''t want to do that. \",\"startTime\":1739897293,\"endTime\":1739897297},{\"speaker\":\"11885\",\"text\":\"It''s like whatever looks the cheapest that I trust. \",\"startTime\":1739897297,\"endTime\":1739897301},{\"speaker\":\"11885\",\"text\":\"Yeah, that''s fine. Like.\",\"startTime\":1739897306,\"endTime\":1739897307},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897306,\"endTime\":1739897307},{\"speaker\":\"11885\",\"text\":\"Same thing with like going out and scheduling things. Like I hate having to \",\"startTime\":1739897307,\"endTime\":1739897312},{\"speaker\":\"11885\",\"text\":\"like actually think whole thoughts unless it''s work, right? But I think, I think, \",\"startTime\":1739897312,\"endTime\":1739897317},{\"speaker\":\"11885\",\"text\":\"I think having that that thought process or the ability or the lack thereof, rather than my everyday like kind of thought has helped me like in my design process and have like an eye for what works and what doesn''t because I feel like the ability to like turn my brain off and kind of. \",\"startTime\":1739897317,\"endTime\":1739897336},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897334,\"endTime\":1739897334},{\"speaker\":\"11885\",\"text\":\"For lack of a better word, kind of get summer.\",\"startTime\":1739897341,\"endTime\":1739897343},{\"speaker\":\"11885\",\"text\":\"Has helped me.\",\"startTime\":1739897345,\"endTime\":1739897346},{\"speaker\":\"11885\",\"text\":\"Like see the world through the eyes of others and understand the way people are going to interact with products such as like an app that, you know, switches side by or my own, you know, understand that. \",\"startTime\":1739897346,\"endTime\":1739897359},{\"speaker\":\"11885\",\"text\":\"In in essence, what I''m getting at is that people''s attention is smart and they operate at their lowest kind of functionality. And if I didn''t maybe like try \",\"startTime\":1739897360,\"endTime\":1739897366},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897363,\"endTime\":1739897364},{\"speaker\":\"11885\",\"text\":\"to shut my brain off and like. \",\"startTime\":1739897366,\"endTime\":1739897370},{\"speaker\":\"11885\",\"text\":\"Not think that much. If I wasn''t so intentionally lazy, I don''t know if I would \",\"startTime\":1739897370,\"endTime\":1739897373},{\"speaker\":\"11885\",\"text\":\"have. \",\"startTime\":1739897373,\"endTime\":1739897375},{\"speaker\":\"11885\",\"text\":\"I don''t know, like had that skill. And so I think the it''s that skill of understanding \",\"startTime\":1739897377,\"endTime\":1739897382},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897380,\"endTime\":1739897380},{\"speaker\":\"11885\",\"text\":\"what we''re getting, the understanding of what people are going to expect and the time and the effort and their mindset that I think I can probably like help \",\"startTime\":1739897382,\"endTime\":1739897392},{\"speaker\":\"11885\",\"text\":\"with the most with, as well as being able to communicate that across the like teams, whether it''s like regardless about technical they are or like non-technical, like what what this means, what what the you know, for example, the chat feature. \",\"startTime\":1739897392,\"endTime\":1739897406},{\"speaker\":\"283\",\"text\":\"Hmm, yeah.\",\"startTime\":1739897393,\"endTime\":1739897395},{\"speaker\":\"11885\",\"text\":\"Doesn''t say chat and it maybe isn''t the most intuitive the chat. Umm uh. There''s \",\"startTime\":1739897411,\"endTime\":1739897415},{\"speaker\":\"283\",\"text\":\"Mm-hmm. Yeah.\",\"startTime\":1739897414,\"endTime\":1739897415},{\"speaker\":\"11885\",\"text\":\"some quick like minor design fixes like that one can make, but I think probably what''s cool is being able to say that too. \",\"startTime\":1739897415,\"endTime\":1739897423},{\"speaker\":\"11885\",\"text\":\"To speak about, you know, what that actually looks like as an HTML element in your TypeScript or something like that, or as a right, Like being able to say the code for that and and type that out and send that to the code person. And \",\"startTime\":1739897426,\"endTime\":1739897438},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897433,\"endTime\":1739897433},{\"speaker\":\"11885\",\"text\":\"then also be able to explain that to the design person as well as to the sales to the solutions. I think the solution engineer, whoever that might be, would \",\"startTime\":1739897438,\"endTime\":1739897447},{\"speaker\":\"11885\",\"text\":\"be the person saying like, Oh yeah, by the way, how the chat feature says chat, something like that I think is the value add as well. \",\"startTime\":1739897447,\"endTime\":1739897455},{\"speaker\":\"283\",\"text\":\"Yeah.\",\"startTime\":1739897456,\"endTime\":1739897457},{\"speaker\":\"283\",\"text\":\"Yeah, that''s super helpful to hear you explain it like that. That makes and \",\"startTime\":1739897457,\"endTime\":1739897460},{\"speaker\":\"283\",\"text\":\"I love the idea of like. \",\"startTime\":1739897460,\"endTime\":1739897462},{\"speaker\":\"283\",\"text\":\"Approach is thinking about well, how will people actually use this, not how will our most excited designer of this use this because that sometimes doesn''t build a functional product for people, for sure. Yeah, yeah, I love that. No, \",\"startTime\":1739897464,\"endTime\":1739897475},{\"speaker\":\"283\",\"text\":\"that''s really helpful framing. Yeah. \",\"startTime\":1739897475,\"endTime\":1739897479},{\"speaker\":\"11885\",\"text\":\"Yeah.\",\"startTime\":1739897476,\"endTime\":1739897477},{\"speaker\":\"283\",\"text\":\"OK, awesome. Well, before we. Yeah, yeah, thank you. Who still before we go \",\"startTime\":1739897481,\"endTime\":1739897485},{\"speaker\":\"11885\",\"text\":\"Thank you, Erica.\",\"startTime\":1739897482,\"endTime\":1739897483},{\"speaker\":\"283\",\"text\":\"because it''ll will it will end it when you press send. So at this point, I would \",\"startTime\":1739897485,\"endTime\":1739897489},{\"speaker\":\"283\",\"text\":