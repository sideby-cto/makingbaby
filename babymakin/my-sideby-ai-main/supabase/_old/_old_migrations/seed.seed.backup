	('1e39285c-a332-4528-9b84-5b399b1863a8', 'Dox', 'Brown', 'I''m energized to join Sideby.ai, where I''ll be crafting collaborative spaces for learners to freely exchange insights, questions, and breakthroughs about AI. My goal is to ensure this exploration remains accessible, meaningful, and empowering for everyone involved.', 'Over the past decade, my teaching has been deeply collaborative and inquiry-driven. I''ve facilitated learning across diverse environments—from classrooms and workshops to specialized corporate trainings—always prioritizing clarity, curiosity, and collaborative exploration. My instructional style blends real-world applications, interactive challenges, and peer-to-peer knowledge exchange, fostering dynamic environments where every participant enriches the collective learning experience.', '{"gifted education","political science",DEI,"American History","World History","Intro to Curriculum Theory","Curriculum & Instruction",economics}', '{"secondary ed (az & co)"}', NULL, '2025-04-10 01:05:33.754838+00', '2025-05-06 16:39:59.583919+00', '{"{\"name\": \"Social  Studies Educator\", \"status\": \"active\"}","{\"name\": \"Microschool Founder\", \"status\": \"active\"}","{\"name\": \"Curriculum Developer\", \"status\": \"active\"}","{\"name\": \"Instructional Designer\", \"status\": \"active\"}","{\"name\": \"AI Thought Leader\", \"status\": \"active\"}"}', 'drew@educeunlimited.com', '{"chat_notifications": true}', NULL, NULL, 'active', NULL, true, NULL, '{"sms": false, "email": true, "in_app": true}', false, NULL, NULL, NULL, true, NULL, NULL),
