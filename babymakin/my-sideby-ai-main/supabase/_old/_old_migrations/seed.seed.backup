	('e2701a87-7881-4b4b-a949-21a553a9ba5e', '663dd69b-d634-4f0d-b28f-abf688fd8bd5', '1da551dd-7a97-4556-a99d-5c3536a61caf', 'Do you see the "enter" button? That''s the first step. If you haven''t done the first little reflection yet, it''ll have you do that first. But then, it''ll start to match you.', '2025-03-26 19:06:18.294622+00', '2025-03-26 19:06:18.294622+00', 'user', NULL),
