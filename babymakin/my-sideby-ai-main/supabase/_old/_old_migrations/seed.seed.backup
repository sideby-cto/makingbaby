INSERT INTO "public"."comments" ("id", "post_id", "user_id", "content", "created_at", "updated_at") VALUES
	('38c94813-7de6-4a6e-8b7e-4584d2fa566e', '111e6b4a-cb10-4969-b64b-8deb59bcd3fa', 'ea155ac4-eb3a-4e24-a4be-84f0143f4348', 'Not yet, let''s start smaller. Simply share an idea, in your own words. 

Others can do a trick I like to call "microtranslate", which makes takes it from your words to theirs. 

Note: "Microtranslate" works better if you''ve shared some of your own ideas, because your posts are part of how it works. 

(Try it on this one!)', '2025-02-07 00:26:27.327208+00', '2025-02-07 00:26:27.327208+00'),
	('23dd7e2e-81e4-4a38-bc36-0a94b3082320', '9b72fd15-d33c-47aa-8e08-c6077b91dbdd', 'ea155ac4-eb3a-4e24-a4be-84f0143f4348', 'Nope, we''ll start with just text and build from there. Try your own microtranslation!', '2025-02-07 01:55:34.417244+00', '2025-02-07 01:55:34.417244+00'),
	('8bba5285-b0d3-4b39-acf3-aff5d789c063', 'cce3c53f-a056-4340-addd-5ef9799140b5', 'ea155ac4-eb3a-4e24-a4be-84f0143f4348', 'Now that''s a good idea. But no, not yet. 

Up next, we''ll work with "conversation transcript", which is a really abundant medium. After your first sideby session, you''ll see it!', '2025-02-07 01:57:08.068491+00', '2025-02-07 01:57:08.068491+00'),
	('d2bafabe-319c-4a2c-bde0-dcd206f71fdb', '78598099-9343-4e45-880c-03cd071b6443', 'ea155ac4-eb3a-4e24-a4be-84f0143f4348', 'Try a microtranslate -- this is student voice. ', '2025-02-11 02:59:44.575938+00', '2025-02-11 02:59:44.575938+00'),
	('2a9e6899-4776-4ba8-92ed-2884d3a3af38', '8b6d7bc2-9f7a-431d-9d83-7775780273b5', '4e8fa647-0aad-4962-a879-826b7edc6dd4', 'You rock! There are three amazing educators who are leaders in MTSS that I can''t wait for you to connect with for some rich discourse!
', '2025-02-19 17:21:38.317218+00', '2025-02-19 17:21:38.317218+00'),
	('61025cdb-3e08-4d51-8f01-5d8df1717a3d', 'f0c1500b-6434-42e3-abd6-ff320914c67c', '4e8fa647-0aad-4962-a879-826b7edc6dd4', 'Here''s a blurb from your reflection. I hope it''s helpful. 
- Jeff', '2025-02-19 21:52:25.128436+00', '2025-02-19 21:52:25.128436+00'),
	('097308ca-f93a-45aa-92aa-7d84a5bbe020', '9a92a685-cfe1-4e7d-b992-d998d7086357', '4e8fa647-0aad-4962-a879-826b7edc6dd4', 'Jeff here. That''s one of the blurbs my robot suggested. 
Cheers!', '2025-02-21 15:53:59.104989+00', '2025-02-21 15:53:59.104989+00');


