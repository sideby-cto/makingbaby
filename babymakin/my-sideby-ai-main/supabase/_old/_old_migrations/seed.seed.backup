	('3f310105-d24a-4cdb-abeb-7b9698ff8f9e', 'a993951b-0689-4ddb-afd4-94b756457d68', '369c68b2-4de2-4ba9-884c-a26d3e5a426d', 'Hi Lorri - I''ve been away on Spring Break. I''m returning to work and available this coming week on Thursday April 3rd at 1:30pm PST. Would that work?', '2025-03-31 02:06:59.338474+00', '2025-03-31 02:06:59.338474+00', 'user', NULL),
	('a078dc0d-59de-46e8-8317-771b70894e48', 'bd369223-cda5-4c61-800e-94a36f61cb1f', '0da1de28-4910-465c-a5f3-0e6d3f975b5e', 'I think you''re moving this week, right? So how about once you''ve settled in on the other side - second week of April?', '2025-03-31 16:01:05.901642+00', '2025-03-31 16:01:05.901642+00', 'user', NULL),
