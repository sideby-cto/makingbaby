INSERT INTO "public"."pending_notifications" ("id", "user_id", "notification_type", "channel", "title", "content", "data", "created_at", "processed_at", "status") VALUES
	('43c513b3-233d-483b-b1d9-b96963d63ab3', 'd3be9b68-297b-416b-828a-eabddea74cb7', 'new_idea', 'email', 'New Idea Added By Admin', 'This is a great idea for you', '{"preview": "This is a great idea for you", "savedItemId": "9b2d03bd-40b1-4417-9efe-7e9d79e77eb7", "adminCreated": true}', '2025-04-11 17:33:20.078288+00', '2025-04-11 17:33:21.562+00', 'sent'),
	('77d92b62-2b6f-4930-8700-99330f7273fa', 'd3be9b68-297b-416b-828a-eabddea74cb7', 'new_idea', 'email', 'New Idea Added By Admin', 'This is basic idea, it should show up in notifications', '{"preview": "This is basic idea, it should show up in notifications", "savedItemId": "be48ae02-0149-4633-bd22-4d87c3fc356e", "adminCreated": true}', '2025-04-14 14:20:33.383157+00', '2025-04-14 14:20:35.541+00', 'sent'),
	('27c9119d-9b0f-4807-9ac2-1ff0adb3beca', '39116d29-cb0e-4f04-b7de-3dd273a92057', 'match_message', 'email', 'New message from Dale Berry', 'Ok, lets try for this Friday at 1:30pm PST!!!', '{"match_id": "a993951b-0689-4ddb-afd4-94b756457d68", "sender_name": "Dale Berry"}', '2025-04-01 22:12:15.40249+00', '2025-04-11 17:25:02.405+00', 'sent'),
	('a804c0f8-eb51-4deb-86e6-ec25a5b1783b', '369c68b2-4de2-4ba9-884c-a26d3e5a426d', 'match_message', 'email', 'New message from Lorri Edwards', 'Perfect. See you then.', '{"match_id": "a993951b-0689-4ddb-afd4-94b756457d68", "sender_name": "Lorri Edwards"}', '2025-04-02 17:04:59.5295+00', '2025-04-11 17:25:03.247+00', 'sent'),
	('b2217e2a-2cf4-4dd6-bf62-274154e08ffe', '44d8b840-888f-4849-9111-b52ada8f4599', 'match_message', 'email', 'New message from Katie Stahl', 'Hey Brittany, do you have any time Thursday or Fri...', '{"match_id": "1d0d67bc-f1a8-47a4-bf8a-de53519392f4", "sender_name": "Katie Stahl"}', '2025-04-02 17:57:55.742125+00', '2025-04-11 17:25:03.886+00', 'sent'),
	('83513bb1-1f6a-4afe-84df-08680712a30a', '6ba21501-22c2-4705-850f-d07844f4dffd', 'match_message', 'email', 'New message from diego2 test', 'hello', '{"match_id": "756fb678-4476-4213-b6bb-1e292d5b2521", "sender_name": "diego2 test"}', '2025-04-08 17:15:02.04803+00', '2025-04-11 17:25:06.474+00', 'sent'),
	('8a6a0b82-8fe4-40b4-91fe-9e0f85facc0b', '6ba21501-22c2-4705-850f-d07844f4dffd', 'match_message', 'email', 'New message from diego2 test', 'hi', '{"match_id": "756fb678-4476-4213-b6bb-1e292d5b2521", "sender_name": "diego2 test"}', '2025-04-08 17:40:50.752615+00', '2025-04-11 17:25:06.474+00', 'sent'),
	('44b55a48-19a2-43b6-9366-0b5542a5a617', '6ba21501-22c2-4705-850f-d07844f4dffd', 'match_message', 'email', 'New message from diego2 test', 'is this getting repeated?', '{"match_id": "756fb678-4476-4213-b6bb-1e292d5b2521", "sender_name": "diego2 test"}', '2025-04-08 17:41:16.256433+00', '2025-04-11 17:25:06.474+00', 'sent'),
