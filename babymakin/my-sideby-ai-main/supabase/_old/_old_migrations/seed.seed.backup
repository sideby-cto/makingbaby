	('05321693-1c34-4f03-a6ad-f0a0c96e7028', 'cd985910-e971-4907-988f-d311b2adb4d1', '78013', '"[]"', '2025-05-06 19:40:27.002959+00', '2025-05-06 19:40:27.002959+00', '{"type": "SINGLE", "duration": 226, "created_at": "2025-05-06T19:40:26.932Z", "session_title": "AI for Educators: Applying AI in Your Job", "knowledgeNodes": [{"id": "196", "name": "AI for Educators: Applying AI in Your Job", "tags": [{"name": "Dream Camp"}, {"name": "AI in Education"}]}], "manually_stored": true}'),
	('95e074af-ea98-4265-ad40-3d77a3e32c60', 'a978d068-04bc-45ac-b24c-f6e367bb9007', '114802', '"[]"', '2025-05-08 03:18:04.52744+00', '2025-05-08 03:18:04.52744+00', '{"type": "SINGLE", "duration": 241, "created_at": "2025-05-08T03:18:04.500Z", "session_title": "Uncovering Student Post-Secondary Access Realities", "knowledgeNodes": [{"id": "1323", "name": "Uncovering Student Post-Secondary Access Realities", "tags": [{"name": "HSLC"}]}], "manually_stored": true}'),
	('0db7c092-c0cc-4117-a4fc-93da7b6676be', 'f75f7f16-84b9-41ce-b842-2a77a9dd70b8', '136010', '"[{\"speaker\":\"262\",\"text\":\"A GPT is a general purpose transformer. It transforms something from one thing \",\"startTime\":1736197630,\"endTime\":1736197635},{\"speaker\":\"262\",\"text\":\"to another thing. English to Spanish, product manager to salesperson, text image. \",\"startTime\":1736197635,\"endTime\":1736197640},{\"speaker\":\"262\",\"text\":\"And main functions are transformed. It''s a. It''s a function generator. It''s \",\"startTime\":1736197643,\"endTime\":1736197647},{\"speaker\":\"262\",\"text\":\"generative, generative pre trained transformer. \",\"startTime\":1736197647,\"endTime\":1736197651},{\"speaker\":\"262\",\"text\":\"Each thread in with these generative tools with GP TS should be its own topic. \",\"startTime\":1736197671,\"endTime\":1736197675},{\"speaker\":\"262\",\"text\":\"These GP TS have memory throughout the dialogue you''ll have with it. So if you \",\"startTime\":1736197675,\"endTime\":1736197679},{\"speaker\":\"262\",\"text\":\"start out by trying to figure out what you''re going to want to eat for dinner, and then you transition to what you want to plan to teach the next day and then transition to like vacation planning, it''s going to get a little confused and confusing. The most obvious place to see it''s confusion is if you start doing \",\"startTime\":1736197679,\"endTime\":1736197695},{\"speaker\":\"262\",\"text\":\"like creating images. \",\"startTime\":1736197695,\"endTime\":1736197699},{\"speaker\":\"262\",\"text\":\"It doesn''t forget what it''s done before.\",\"startTime\":1736197702,\"endTime\":1736197703},{\"speaker\":\"262\",\"text\":\"So so you should stay in one when you''re on one topic. Now this is changing \",\"startTime\":1736197704,\"endTime\":1736197709},{\"speaker\":\"262\",\"text\":\"as these models have larger context windows as when they can handle more information and some applications like website like app like web app building require you to stay in one thread forever. But I guess that is 1 project. So so start a \",\"startTime\":1736197709,\"endTime\":1736197724},{\"speaker\":\"262\",\"text\":\"new thread when it''s a new idea and a new category of thinking. \",\"startTime\":1736197724,\"endTime\":1736197730},{\"speaker\":\"262\",\"text\":\"Teacher would my zone of proximal development right now is in going from text to application like web apps, like a like an app. I can build apps now I can \",\"startTime\":1736197746,\"endTime\":1736197759},{\"speaker\":\"262\",\"text\":\"create an application that has login and passwords and storage and intelligence that can use GPT all through conversations like that like ChatGPT. \",\"startTime\":1736197759,\"endTime\":1736197773},{\"speaker\":\"262\",\"text\":\"Think I want to get better at.\",\"startTime\":1736197773,\"endTime\":1736197774}]"', '2025-05-06 19:02:28.368371+00', '2025-05-06 19:02:28.368371+00', '{"type": "SINGLE", "duration": 137, "created_at": "2025-05-06T19:02:28.170Z", "session_title": "Understanding and Utilizing GPT and AI Threads", "knowledgeNodes": [{"id": "197", "name": "Understanding and Utilizing GPT and AI Threads", "tags": [{"name": "Dream Camp"}, {"name": "ColumbiaSelkirk"}, {"name": "AI in Education"}, {"name": "Freemium"}]}], "manually_stored": true}'),
	('174f360f-81bd-4aa0-9726-e148c690ac9b', '760ebb56-9a35-4b72-8b73-bc98a5f056a3', '134594', '"[{\"speaker\":\"11325\",\"text\":\"Hi, I''m Ryan Hastan, the principal at Harbor Heights Elementary. What do I hope \",\"startTime\":1732054354,\"endTime\":1732054359},{\"speaker\":\"11325\",\"text\":\"to teach? Well, when I get back to my building, I''m going to hope to teach a \",\"startTime\":1732054359,\"endTime\":1732054363},{\"speaker\":\"11325\",\"text\":\"lot of our teachers how to utilize AI in an effective manner to save some time. \",\"startTime\":1732054363,\"endTime\":1732054368},{\"speaker\":\"11325\",\"text\":\"And what do I hope to learn about? I kind of hope to learn where they''re all \",\"startTime\":1732054368,\"endTime\":1732054373},{\"speaker\":\"11325\",\"text\":\"at with technology and how we can support them further. \",\"startTime\":1732054373,\"endTime\":1732054377}]"', '2025-05-08 03:17:46.557549+00', '2025-05-08 03:17:46.557549+00', '{"type": "SINGLE", "duration": 27, "created_at": "2025-05-08T03:17:46.532Z", "session_title": "Welcome to sideby!", "knowledgeNodes": [{"id": "22", "name": "Welcome to sideby!", "tags": [{"name": "Active"}, {"name": "ColumbiaSelkirk"}, {"name": "Leaders of Color"}]}], "manually_stored": true}'),
	('e936c514-c3a0-424c-9ad3-2a955dc652de', '4734e9cf-74b7-4e89-b92c-8dc6f49c5b2a', '96179', '"[]"', '2025-05-06 19:40:27.271583+00', '2025-05-06 19:40:27.271583+00', '{"type": "SINGLE", "duration": 54, "created_at": "2025-05-06T19:40:27.048Z", "session_title": "Welcome to sideby!", "knowledgeNodes": [{"id": "22", "name": "Welcome to sideby!", "tags": [{"name": "Active"}, {"name": "ColumbiaSelkirk"}, {"name": "Leaders of Color"}]}], "manually_stored": true}'),
	('e6da06ee-e341-4088-b9d1-c895e7a7d3cd', '4734e9cf-74b7-4e89-b92c-8dc6f49c5b2a', '135715', '"[{\"speaker\":\"8437\",\"text\":\"Oh hey, I''m making you better. As a teacher, there''s a number of different ways \",\"startTime\":1734449533,\"endTime\":1734449535},{\"speaker\":\"8437\",\"text\":\"that can happen. \",\"startTime\":1734449535,\"endTime\":1734449536},{\"speaker\":\"8437\",\"text\":\"1st is just the ability to craft lessons, become more efficient research.\",\"startTime\":1734449540,\"endTime\":1734449546},{\"speaker\":\"8437\",\"text\":\"Exposure put things together. I mean these. I think about crunching data.\",\"startTime\":1734449549,\"endTime\":1734449554},{\"speaker\":\"8437\",\"text\":\"I mean, there''s what what can''t assist with.\",\"startTime\":1734449558,\"endTime\":1734449560},{\"speaker\":\"8437\",\"text\":\"Yeah, this kind of, but sorry.\",\"startTime\":1734449564,\"endTime\":1734449566},{\"speaker\":\"8437\",\"text\":\"I can''t even imagine what it would have been like to have AI at my disposal of the classroom teacher. It would have been an indispensable tool. \",\"startTime\":1734449568,\"endTime\":1734449575},{\"speaker\":\"8437\",\"text\":\"Interventions. Universal design for learning enrichment.\",\"startTime\":1734449578,\"endTime\":1734449583},{\"speaker\":\"8437\",\"text\":\"Personalized learning for some kids in order for me to grab some pieces for them to put stuff together, but more importantly for the kids to be able to utilize it in a fashion and manner that could take them many different directions. \",\"startTime\":1734449586,\"endTime\":1734449598},{\"speaker\":\"8437\",\"text\":\"I think the ability to maybe embed some kind of higher order thinking skills and and. \",\"startTime\":1734449598,\"endTime\":1734449607},{\"speaker\":\"8437\",\"text\":\"The inquiry process, but the ability to discern and filter, which is critically important, but it''s something that we as as educators need to build within our kids. \",\"startTime\":1734449611,\"endTime\":1734449622},{\"speaker\":\"8437\",\"text\":\"Oh, the foundational skills and proficiencies that I already have.\",\"startTime\":1734449648,\"endTime\":1734449651},{\"speaker\":\"8437\",\"text\":\"You know, I think just anybody, well I shouldn''t say anybody, but just the ability \",\"startTime\":1734449652,\"endTime\":1734449658},{\"speaker\":\"8437\",\"text\":\"to quickly generate and find information, the ability to upload craft knowledge and have AI assist me in in creating activities, professional learning kinds of sequences based specifically on on knowledge. \",\"startTime\":1734449658,\"endTime\":1734449677},{\"speaker\":\"8437\",\"text\":\"That I upload.\",\"startTime\":1734449678,\"endTime\":1734449679},{\"speaker\":\"8437\",\"text\":\"I''ve been able to create a couple of bots general information in relationship to foundational documents that we use on a on a regular basis in our work. \",\"startTime\":1734449680,\"endTime\":1734449690},{\"speaker\":\"8437\",\"text\":\"I don''t know that, you know, workflows. That''s an area that I want to expand \",\"startTime\":1734449693,\"endTime\":1734449696},{\"speaker\":\"8437\",\"text\":\"on and explore a little bit more. \",\"startTime\":1734449696,\"endTime\":1734449699},{\"speaker\":\"8437\",\"text\":\"But I think about next step.\",\"startTime\":1734449736,\"endTime\":1734449737},{\"speaker\":\"8437\",\"text\":\"And pieces I''d like to explore a little bit more researching tools and things like that, but content creation, video creation, music creation, podcast creation, summarizing documents and taking that a step further and be able to create blog information and other items with that. \",\"startTime\":1734449738,\"endTime\":1734449761},{\"speaker\":\"8437\",\"text\":\"I just need to. I know I''ve looked up a bunch of different free courses and \",\"startTime\":1734449765,\"endTime\":1734449769},{\"speaker\":\"8437\",\"text\":\"resources on you to me and other places. \",\"startTime\":1734449769,\"endTime\":1734449773},{\"speaker\":\"8437\",\"text\":\"I just need to be focused and that stuff done.\",\"startTime\":1734449774,\"endTime\":1734449777}]"', '2025-05-06 19:02:28.182681+00', '2025-05-06 19:02:28.182681+00', '{"type": "SINGLE", "duration": 212, "created_at": "2025-05-06T19:02:28.114Z", "session_title": "AI for Educators: Applying AI in Your Job", "knowledgeNodes": [{"id": "196", "name": "AI for Educators: Applying AI in Your Job", "tags": [{"name": "Dream Camp"}, {"name": "AI in Education"}]}], "manually_stored": true}'),
	('04ffa665-b08e-4b3e-9678-770242ad18ad', '713b8455-cc3b-4ab1-bcfb-255f93bf56b0', '136593', '"[{\"speaker\":\"11773\",\"text\":\"Let me mute this.\",\"startTime\":1738002387,\"endTime\":1738002389},{\"speaker\":\"11773\",\"text\":\"OK.\",\"startTime\":1738002391,\"endTime\":1738002391},{\"speaker\":\"8084\",\"text\":\"Yay, you hear me? OK.\",\"startTime\":1738002391,\"endTime\":1738002396},{\"speaker\":\"11773\",\"text\":\"I can loud and clear.\",\"startTime\":1738002394,\"endTime\":1738002396},{\"speaker\":\"8084\",\"text\":\"Sweet, sweet, sweet. Oh, and we are in AI learning tools. Yes, we made it.\",\"startTime\":1738002397,\"endTime\":1738002402},{\"speaker\":\"8084\",\"text\":\"Sweet, sweet. OK, great. Your partner Dale. Hello, Dale and Ice Baker. What''s \",\"startTime\":1738002403,\"endTime\":1738002409},{\"speaker\":\"11773\",\"text\":\"Fantastic.\",\"startTime\":1738002403,\"endTime\":1738002404},{\"speaker\":\"8084\",\"text\":\"your favorite book or movie that features futuristic technology and why? \",\"startTime\":1738002409,\"endTime\":1738002414},{\"speaker\":\"11773\",\"text\":\"I like Dune was a really interesting, It''s a really fascinating concept. I remember \",\"startTime\":1738002416,\"endTime\":1738002421},{\"speaker\":\"11773\",\"text\":\"reading the book a long time ago and just being like fascinated by. \",\"startTime\":1738002421,\"endTime\":1738002426},{\"speaker\":\"11773\",\"text\":\"A world of no water or or or like the value of that water. Yeah. And processing \",\"startTime\":1738002427,\"endTime\":1738002431},{\"speaker\":\"11773\",\"text\":\"it in that way. So, yeah, I would say like Dune was a was a fascinating book \",\"startTime\":1738002431,\"endTime\":1738002435},{\"speaker\":\"11773\",\"text\":\"for me. What about you? \",\"startTime\":1738002435,\"endTime\":1738002439},{\"speaker\":\"8084\",\"text\":\"That''s a good one. The Matrix gets my brain all in a buzz.\",\"startTime\":1738002440,\"endTime\":1738002447},{\"speaker\":\"8084\",\"text\":\"Just because of that, being able to connect into our neurology and.\",\"startTime\":1738002448,\"endTime\":1738002453},{\"speaker\":\"8084\",\"text\":\"To have some of that time like of what''s going on, and I know that doesn''t work that way, but something magical about downloading the ability to fly a helicopter or something instantly. \",\"startTime\":1738002454,\"endTime\":1738002466},{\"speaker\":\"11773\",\"text\":\"Yeah.\",\"startTime\":1738002467,\"endTime\":1738002468},{\"speaker\":\"8084\",\"text\":\"Yeah.\",\"startTime\":1738002469,\"endTime\":1738002470},{\"speaker\":\"8084\",\"text\":\"But that, yeah, that that movie was one that just made my brain think pretty hard about stuff like that. \",\"startTime\":1738002471,\"endTime\":1738002477},{\"speaker\":\"11773\",\"text\":\"Awesome. So we we go on to the next prompt. Partner ready, OK.\",\"startTime\":1738002478,\"endTime\":1738002482},{\"speaker\":\"8084\",\"text\":\"Yeah, yeah, yeah. Partner ready.\",\"startTime\":1738002481,\"endTime\":1738002484},{\"speaker\":\"11773\",\"text\":\"Oh, would you like me to go first?\",\"startTime\":1738002486,\"endTime\":1738002488},{\"speaker\":\"8084\",\"text\":\"How has?\",\"startTime\":1738002487,\"endTime\":1738002488},{\"speaker\":\"8084\",\"text\":\"Because mine says ask Dale, I''m guessing does your say ask Jeff?\",\"startTime\":1738002489,\"endTime\":1738002492},{\"speaker\":\"11773\",\"text\":\"It just says share first.\",\"startTime\":1738002493,\"endTime\":1738002495},{\"speaker\":\"8084\",\"text\":\"OK, OK, so ask Dale.\",\"startTime\":1738002495,\"endTime\":1738002497},{\"speaker\":\"8084\",\"text\":\"How has AI changed your work as an educator or leader of educators so far?\",\"startTime\":1738002497,\"endTime\":1738002504},{\"speaker\":\"11773\",\"text\":\"Look, it''s.\",\"startTime\":1738002508,\"endTime\":1738002510},{\"speaker\":\"11773\",\"text\":\"It''s totally changed the way that I work, I would say.\",\"startTime\":1738002512,\"endTime\":1738002517},{\"speaker\":\"11773\",\"text\":\"The umm a large part of the compliance of my job and different paperwork, elements of my job and my ability to differentiate across different classes and grades. \",\"startTime\":1738002519,\"endTime\":1738002531},{\"speaker\":\"11773\",\"text\":\"Umm, and do that in in such a like a a, a ramped up way has totally changed the way that I. \",\"startTime\":1738002531,\"endTime\":1738002540},{\"speaker\":\"11773\",\"text\":\"And them able to present myself to kids and to be really present in.\",\"startTime\":1738002541,\"endTime\":1738002547},{\"speaker\":\"11773\",\"text\":\"The most important stuff of my job. So yeah, I, I would say it''s had a massive \",\"startTime\":1738002547,\"endTime\":1738002550},{\"speaker\":\"11773\",\"text\":\"impact on, on what I do. \",\"startTime\":1738002550,\"endTime\":1738002553},{\"speaker\":\"8084\",\"text\":\"Wow, give me more detail. Like what''s 1 area that you''d say is massive impact? \",\"startTime\":1738002555,\"endTime\":1738002560},{\"speaker\":\"11773\",\"text\":\"Yeah, it''s my ability to differentiate for different students. Umm.\",\"startTime\":1738002561,\"endTime\":1738002566},{\"speaker\":\"11773\",\"text\":\"Within minutes of seeing either lessons or a lesson that I walked into or.\",\"startTime\":1738002570,\"endTime\":1738002577},{\"speaker\":\"11773\",\"text\":\"When I''m interacting with a student with with a text or with a math or or.\",\"startTime\":1738002580,\"endTime\":1738002587},{\"speaker\":\"11773\",\"text\":\"Something that my student is struggling with or needs accessibility points into to engage with this task. I''m able to differentiate it. \",\"startTime\":1738002588,\"endTime\":1738002598},{\"speaker\":\"11773\",\"text\":\"In such a fast and accurate way that that then allows my students to have different entry points into. \",\"startTime\":1738002599,\"endTime\":1738002607},{\"speaker\":\"11773\",\"text\":\"That new learning.\",\"startTime\":1738002607,\"endTime\":1738002608},{\"speaker\":\"8084\",\"text\":\"That seems so efficient.\",\"startTime\":1738002611,\"endTime\":1738002612},{\"speaker\":\"8084\",\"text\":\"Having a tool to be able to get those differentiations right away.\",\"startTime\":1738002614,\"endTime\":1738002617},{\"speaker\":\"8084\",\"text\":\"That''s pretty cool.\",\"startTime\":1738002617,\"endTime\":1738002618},{\"speaker\":\"11773\",\"text\":\"Yeah.\",\"startTime\":1738002619,\"endTime\":1738002619},{\"speaker\":\"8084\",\"text\":\"OK, that''s mine just says ask you and then yours. Yours says share.\",\"startTime\":1738002622,\"endTime\":1738002627},{\"speaker\":\"11773\",\"text\":\"Yeah, mine says. I mentioned specific AI tools and look, I''ve looked at different \",\"startTime\":1738002626,\"endTime\":1738002630},{\"speaker\":\"11773\",\"text\":\"tools and I know it seems like. \",\"startTime\":1738002630,\"endTime\":1738002634},{\"speaker\":\"11773\",\"text\":\"Every week there''s new tools, right that who can the new AI tools, they can do different things and I''m I''m certain that all of them have amazing value or, or or value in different ways, but. \",\"startTime\":1738002635,\"endTime\":1738002646},{\"speaker\":\"11773\",\"text\":\"I started to create.\",\"startTime\":1738002649,\"endTime\":1738002653},{\"speaker\":\"11773\",\"text\":\"GPT. So in Chat GPTS, I create an account. I created individual GPTS for individual \",\"startTime\":1738002653,\"endTime\":1738002658},{\"speaker\":\"11773\",\"text\":\"tasks that I have in my job that sort of take up the biggest volume of time. \",\"startTime\":1738002658,\"endTime\":1738002664},{\"speaker\":\"11773\",\"text\":\"So I''ve been really focused on creating Chat GPTS and then training those GPTS over the last year to get the information that I want in the format that I want, in the tone and voice that I want. So yeah, it''s been very much. \",\"startTime\":1738002664,\"endTime\":1738002682},{\"speaker\":\"11773\",\"text\":\"Or ChatGPT.\",\"startTime\":1738002683,\"endTime\":1738002683},{\"speaker\":\"8084\",\"text\":\"I like it. Tell me more about the training. How are you doing the training of \",\"startTime\":1738002684,\"endTime\":1738002687},{\"speaker\":\"8084\",\"text\":\"the GPTS to get what you want? \",\"startTime\":1738002687,\"endTime\":1738002689},{\"speaker\":\"11773\",\"text\":\"Yeah, you know, like I''m when I ask her questions.\",\"startTime\":1738002690,\"endTime\":1738002693},{\"speaker\":\"11773\",\"text\":\"Well, first of all, setting it up is a key part is like you''re saying, OK, I want you to be an expert in this, this, this and this. I want you to. \",\"startTime\":1738002694,\"endTime\":1738002702},{\"speaker\":\"11773\",\"text\":\"Learn or or focus on information from these different resources, right?\",\"startTime\":1738002704,\"endTime\":1738002709},{\"speaker\":\"11773\",\"text\":\"As a special educator, that might be the idea in Wisconsin, it''s the Wisconsin State standards, OK, So I need it to be pulling from those resources and be an expert there. And I needed to give it to me in a tone that is suitable for \",\"startTime\":1738002710,\"endTime\":1738002722},{\"speaker\":\"11773\",\"text\":\"student centered learning. I, I need it in El education, which is the model \",\"startTime\":1738002722,\"endTime\":1738002726},{\"speaker\":\"11773\",\"text\":\"that I work in, or I need it to consider the sort of the deeper learning platform. \",\"startTime\":1738002726,\"endTime\":1738002731},{\"speaker\":\"11773\",\"text\":\"So I''m saying. \",\"startTime\":1738002731,\"endTime\":1738002735},{\"speaker\":\"11773\",\"text\":\"Give me this information, give it to me in the format that I want from the resources that I believe in and I know to be true and the in the, in the sort of voice and the tone that is most suitable for for my students. So over time, you, you, \",\"startTime\":1738002736,\"endTime\":1738002750},{\"speaker\":\"11773\",\"text\":\"you sort of train out or do your best to train out the bias in the information that you''ve got or the different. \",\"startTime\":1738002750,\"endTime\":1738002760},{\"speaker\":\"11773\",\"text\":\"It starts to understand what you''re looking for and the formats that you''re looking for and in the voice that you''re looking for. \",\"startTime\":1738002761,\"endTime\":1738002768},{\"speaker\":\"11773\",\"text\":\"So that that''s what I mean by train.\",\"startTime\":1738002768,\"endTime\":1738002770},{\"speaker\":\"8084\",\"text\":\"Are you noticing that just by using it, it gets better at doing what it''s doing because you give it feedback on how you want things even after the original setup? \",\"startTime\":1738002770,\"endTime\":1738002780},{\"speaker\":\"11773\",\"text\":\"Yes, I had an instant saw last week where I worked on this thing for a couple of hours to create. \",\"startTime\":1738002780,\"endTime\":1738002786},{\"speaker\":\"11773\",\"text\":\"My minutes where I could just put in minutes.\",\"startTime\":1738002787,\"endTime\":1738002789},{\"speaker\":\"11773\",\"text\":\"And be able to transfer that into a format and a line item that is in for compliance. \",\"startTime\":1738002790,\"endTime\":1738002798},{\"speaker\":\"11773\",\"text\":\"That traditionally took me a long time to do, and now?\",\"startTime\":1738002798,\"endTime\":1738002803},{\"speaker\":\"11773\",\"text\":\"Now it gives it to me after quite a bit of work. It gives it to me in the format \",\"startTime\":1738002804,\"endTime\":1738002808},{\"speaker\":\"11773\",\"text\":\"that I want. So I''m able to just put very quickly, put in information in there \",\"startTime\":1738002808,\"endTime\":1738002811},{\"speaker\":\"11773\",\"text\":\"at different intervals and then say, hey, I need you to, you know, in the format that I want, compiled all the information. \",\"startTime\":1738002811,\"endTime\":1738002818},{\"speaker\":\"11773\",\"text\":\"In my preferred template go, you know, for whatever date period go and then it just goes bang. I just copy paste it into a compliance document and I''m done. \",\"startTime\":1738002819,\"endTime\":1738002828},{\"speaker\":\"8084\",\"text\":\"That''s awesome. That''s awesome.\",\"startTime\":1738002830,\"endTime\":1738002832},{\"speaker\":\"8084\",\"text\":\"Uh, OK, I''m gonna hit next and unless you''ve got more, that''s that''s way cool. \",\"startTime\":1738002833,\"endTime\":1738002839},{\"speaker\":\"8084\",\"text\":\"Big turn sharing with Dale. How do you think AI will change the role of learners \",\"startTime\":1738002845,\"endTime\":1738002848},{\"speaker\":\"8084\",\"text\":\"in the future? \",\"startTime\":1738002848,\"endTime\":1738002850},{\"speaker\":\"8084\",\"text\":\"One I think like what you were just saying, I was doing similar roles with using GP TS and creating them. And by the way I gave many of my GP TS names like I \",\"startTime\":1738002854,\"endTime\":1738002861},{\"speaker\":\"8084\",\"text\":\"have cuddles. \",\"startTime\":1738002861,\"endTime\":1738002864},{\"speaker\":\"8084\",\"text\":\"Cuddles is a cuttlefish and Cuddles is my business consultant with all of my docs for my personal business stuff. And this helps me to know which GPT to \",\"startTime\":1738002864,\"endTime\":1738002873},{\"speaker\":\"8084\",\"text\":\"talk to. At times they''re like, Oh yeah, talk to Cuddles. \",\"startTime\":1738002873,\"endTime\":1738002878},{\"speaker\":\"8084\",\"text\":\"But that how to start it up and get it moving forward. I think for students \",\"startTime\":1738002879,\"endTime\":1738002884},{\"speaker\":\"8084\",\"text\":\"similarly about giving them the tools to create GP T. \",\"startTime\":1738002884,\"endTime\":1738002889},{\"speaker\":\"8084\",\"text\":\"As assistance to do the work that they want to do. So if their project is something \",\"startTime\":1738002892,\"endTime\":1738002897},{\"speaker\":\"8084\",\"text\":\"about skateboarding ramps, for example, I want to build skateboard ramps because that''s what I''m excited about. They might build their GP TS to do the different \",\"startTime\":1738002897,\"endTime\":1738002906},{\"speaker\":\"8084\",\"text\":\"components around whether it''s the engineering of that or the the procurement of resources or the liabilities of it or the. \",\"startTime\":1738002906,\"endTime\":1738002915},{\"speaker\":\"8084\",\"text\":\"Maintenance or whatever it might be, but they''ll have to start becoming creative of thinking. \",\"startTime\":1738002916,\"endTime\":1738002922},{\"speaker\":\"8084\",\"text\":\"How do I use these tools? In particular, how do I create assistance that will \",\"startTime\":1738002922,\"endTime\":1738002927},{\"speaker\":\"8084\",\"text\":\"help me do what I want to do to reach my bigger project? \",\"startTime\":1738002927,\"endTime\":1738002931},{\"speaker\":\"8084\",\"text\":\"So I think it''s going to change the role of learners and what they''re doing as it will give them more power to do things and to create assistance, like what you''re saying, to expedite and become efficient with the work that they''re doing. I see that as a real, real key. And, and again, that''s like level 2 and \",\"startTime\":1738002932,\"endTime\":1738002948},{\"speaker\":\"11773\",\"text\":\"MMM, yeah.\",\"startTime\":1738002947,\"endTime\":1738002947},{\"speaker\":\"8084\",\"text\":\"3 users of, of AI tools, But that, that''s what I see right away is that that students, learners in general that we''re going to be thinking, oh, how? \",\"startTime\":1738002948,\"endTime\":1738002957},{\"speaker\":\"8084\",\"text\":\"How do I get myself an assistant to help?\",\"startTime\":1738002959,\"endTime\":1738002961},{\"speaker\":\"8084\",\"text\":\"Become more efficient and get just get the tedious stuff done fast.\",\"startTime\":1738002962,\"endTime\":1738002966},{\"speaker\":\"11773\",\"text\":\"Yeah.\",\"startTime\":1738002963,\"endTime\":1738002963},{\"speaker\":\"11773\",\"text\":\"Yeah, that''s really interesting, Jeff, that mindset.\",\"startTime\":1738002966,\"endTime\":1738002969},{\"speaker\":\"11773\",\"text\":\"Like of what it can do and like what I can, what it can help me achieve I guess and learn. \",\"startTime\":1738002972,\"endTime\":1738002978},{\"speaker\":\"11773\",\"text\":\"I think that mindset is a big shift for adults and probably it''s probably not that big a shift for kids. They they kids adapt and learn really, really quickly. \",\"startTime\":1738002979,\"endTime\":1738002989},{\"speaker\":\"8084\",\"text\":\"Yeah.\",\"startTime\":1738002990,\"endTime\":1738002991},{\"speaker\":\"11773\",\"text\":\"Uponting the mindset around AI and different tools are really slow progression for a lot of adults. Some are early adopters. They''re like, Oh yeah, this can \",\"startTime\":1738002991,\"endTime\":1738002998},{\"speaker\":\"11773\",\"text\":\"this, this is really helpful. I can use this immediately to do this, this and \",\"startTime\":1738002998,\"endTime\":1738003002},{\"speaker\":\"11773\",\"text\":\"this. \",\"startTime\":1738003002,\"endTime\":1738003006},{\"speaker\":\"11773\",\"text\":\"And and other sort of new learners are a little bit like, oh, that seems.\",\"startTime\":1738003006,\"endTime\":1738003011},{\"speaker\":\"11773\",\"text\":\"Like, uh.\",\"startTime\":1738003013,\"endTime\":1738003014},{\"speaker\":\"11773\",\"text\":\"They sort of zone, they sort of zoom back and they''re like, oh, I don''t know if this is the right way and what are the implications to this? And like, there''s \",\"startTime\":1738003014,\"endTime\":1738003021},{\"speaker\":\"11773\",\"text\":\"there, but I feel like. \",\"startTime\":1738003021,\"endTime\":1738003024},{\"speaker\":\"11773\",\"text\":\"There''s a there''s a mindset shift that has to occur.\",\"startTime\":1738003027,\"endTime\":1738003031},{\"speaker\":\"11773\",\"text\":\"So adult learners are now teachers and people who are.\",\"startTime\":1738003032,\"endTime\":1738003036},{\"speaker\":\"11773\",\"text\":\"Who can anyone can use this you know to to be creative and save some self save themselves time and learn. \",\"startTime\":1738003037,\"endTime\":1738003043},{\"speaker\":\"11773\",\"text\":\"But that''s a the, the mindset shift is a really interesting one for for adult learners, I think. \",\"startTime\":1738003044,\"endTime\":1738003051},{\"speaker\":\"8084\",\"text\":\"Yeah, I think even for younger students who grow up and adults who have grown up in spoon feeding, sit still and and I''ll tell you Dale, how to do it. Just \",\"startTime\":1738003053,\"endTime\":1738003065},{\"speaker\":\"8084\",\"text\":\"take the nose and when we are in that. \",\"startTime\":1738003065,\"endTime\":1738003069},{\"speaker\":\"8084\",\"text\":\"Non creative, non owning of our learning. When I don''t own my learning and I''m \",\"startTime\":1738003069,\"endTime\":1738003074},{\"speaker\":\"8084\",\"text\":\"not the one at the driver''s seat for what I''m doing and I''m waiting for somebody else to tell me what to do, then I will become more and more stressed about doing this because it does require creativity. And, and as you were talking, \",\"startTime\":1738003074,\"endTime\":1738003086},{\"speaker\":\"8084\",\"text\":\"it made me think about there''s that math practice standard about using appropriate tools strategically. And that means that kids would need and learners would \",\"startTime\":1738003086,\"endTime\":1738003094},{\"speaker\":\"8084\",\"text\":\"need choice. \",\"startTime\":1738003094,\"endTime\":1738003098},{\"speaker\":\"8084\",\"text\":\"To use appropriate tools strategically, you have to have a bunch of tools on the table and have a need for using tools. And that''s a messy, chaotic place. \",\"startTime\":1738003100,\"endTime\":1738003108},{\"speaker\":\"8084\",\"text\":\"And for many of us, we don''t like that. And so for my point is if if you have \",\"startTime\":1738003108,\"endTime\":1738003112},{\"speaker\":\"11773\",\"text\":\"Yep, yeah.\",\"startTime\":1738003109,\"endTime\":1738003111},{\"speaker\":\"8084\",\"text\":\"grown up or you''ve been in that special Ed is typically this, which is sad. \",\"startTime\":1738003112,\"endTime\":1738003117},{\"speaker\":\"8084\",\"text\":\"Let me just feed you now and just wait. I''ll be with you in a minute. Dale, \",\"startTime\":1738003117,\"endTime\":1738003121},{\"speaker\":\"8084\",\"text\":\"don''t do anything yet. I''ll be over there in a minute to show you how to do \",\"startTime\":1738003121,\"endTime\":1738003125},{\"speaker\":\"8084\",\"text\":\"it. \",\"startTime\":1738003125,\"endTime\":1738003129},{\"speaker\":\"8084\",\"text\":\"If that''s the case, then you''re not authentically being a human being who''s autonomous, and how do we cultivate that? So I think the role of learners, as \",\"startTime\":1738003130,\"endTime\":1738003139},{\"speaker\":\"8084\",\"text\":\"you said, is much around helping them become the independent. \",\"startTime\":1738003139,\"endTime\":1738003143},{\"speaker\":\"8084\",\"text\":\"Learner that they need to be in supporting them along the way and their role will be ownership more and more ownership. What assistance do they need? What \",\"startTime\":1738003145,\"endTime\":1738003152},{\"speaker\":\"8084\",\"text\":\"tutors do they do they need like I''m hearing. \",\"startTime\":1738003152,\"endTime\":1738003155},{\"speaker\":\"11773\",\"text\":\"Yeah.\",\"startTime\":1738003156,\"endTime\":1738003156},{\"speaker\":\"8084\",\"text\":\"I read from Mike, he had a feedback from one of his students earlier this week and it was saying that the student is using AI tools as its his own tutor. When \",\"startTime\":1738003156,\"endTime\":1738003166},{\"speaker\":\"8084\",\"text\":\"he goes home he''s having it help teach him and he''s like. \",\"startTime\":1738003166,\"endTime\":1738003170},{\"speaker\":\"8084\",\"text\":\"That I can access a teacher is what he was calling it. That I don''t need my. \",\"startTime\":1738003172,\"endTime\":1738003177},{\"speaker\":\"8084\",\"text\":\"Classroom teacher, I can go and get these other teachers, and I''ve heard from other people too, teachers as well, that as they''re supporting their students, they''re like, I don''t know all of this stuff, man. So I''m going online and I''m \",\"startTime\":1738003178,\"endTime\":1738003189},{\"speaker\":\"8084\",\"text\":\"having the AI to help me learn about whatever it was that they needed to help learn to help their students. \",\"startTime\":1738003189,\"endTime\":1738003197},{\"speaker\":\"8084\",\"text\":\"So there, yeah.\",\"startTime\":1738003197,\"endTime\":1738003198},{\"speaker\":\"11773\",\"text\":\"That is, I mean, that is, that''s a really.\",\"startTime\":1738003198,\"endTime\":1738003201},{\"speaker\":\"11773\",\"text\":\"That''s a really interesting.\",\"startTime\":1738003201,\"endTime\":1738003202},{\"speaker\":\"11773\",\"text\":\"A really interesting option and.\",\"startTime\":1738003205,\"endTime\":1738003208},{\"speaker\":\"11773\",\"text\":\"That will be like, there''s a lot of in the environment that I work, there''s a lot of concern about the way kids are using it, even even the way the teachers are using it and. \",\"startTime\":1738003211,\"endTime\":1738003221},{\"speaker\":\"11773\",\"text\":\"That''s an excellent example of a really creative and positive way that students can really benefit from their use of of a tool. \",\"startTime\":1738003222,\"endTime\":1738003234},{\"speaker\":\"11773\",\"text\":\"Like this or like, you know, ChatGPT for example, they were talking about before. \",\"startTime\":1738003234,\"endTime\":1738003237},{\"speaker\":\"11773\",\"text\":\"That''s that''s super interesting. \",\"startTime\":1738003237,\"endTime\":1738003240},{\"speaker\":\"8084\",\"text\":\"Yeah, I''ll, I''ll send you that quote from Mike''s kid. It was, it was wonderful \",\"startTime\":1738003241,\"endTime\":1738003244},{\"speaker\":\"8084\",\"text\":\"to see that. And you''re like, oh. \",\"startTime\":1738003244,\"endTime\":1738003247},{\"speaker\":\"8084\",\"text\":\"That''s what I hope my students would write after my course or at the end of a term. \",\"startTime\":1738003247,\"endTime\":1738003251},{\"speaker\":\"11773\",\"text\":\"Yeah.\",\"startTime\":1738003251,\"endTime\":1738003251},{\"speaker\":\"8084\",\"text\":\"Yeah, yeah. All right, I''ll share it later. The one part I have it up here. \",\"startTime\":1738003252,\"endTime\":1738003257},{\"speaker\":\"8084\",\"text\":\"I like to make music and produce songs, but I still have a lot to learn. \",\"startTime\":1738003257,\"endTime\":1738003262},{\"speaker\":\"8084\",\"text\":\"And then he goes on to describe I never thought of AI as a teacher. After school, \",\"startTime\":1738003263,\"endTime\":1738003267},{\"speaker\":\"8084\",\"text\":\"I went home, and whenever I had questions about music, I would turn to AI for answers. This worked way better than I thought and changed my entire view on \",\"startTime\":1738003267,\"endTime\":1738003274},{\"speaker\":\"8084\",\"text\":\"AI. There''s more to the quote, but those are a couple highlights for you. Yeah. \",\"startTime\":1738003274,\"endTime\":1738003277},{\"speaker\":\"8084\",\"text\":\"All right. I''m ready for the next card. \",\"startTime\":1738003277,\"endTime\":1738003281},{\"speaker\":\"11773\",\"text\":\"Yeah. Thank you.\",\"startTime\":1738003279,\"endTime\":1738003280},{\"speaker\":\"8084\",\"text\":\"A scenario.\",\"startTime\":1738003286,\"endTime\":1738003287},{\"speaker\":\"11773\",\"text\":\"Yup.\",\"startTime\":1738003287,\"endTime\":1738003287},{\"speaker\":\"11773\",\"text\":\"S s OK umm I''m sorry just you best respond to this situation. Read the scenario. \",\"startTime\":1738003291,\"endTime\":1738003295},{\"speaker\":\"11773\",\"text\":\"It''s a scenario. \",\"startTime\":1738003295,\"endTime\":1738003299},{\"speaker\":\"8084\",\"text\":\"Bender Moore, you have you have been asked to implement an AI driven platform at your school that personalizes learning for each student. Some teachers are \",\"startTime\":1738003305,\"endTime\":1738003312},{\"speaker\":\"11773\",\"text\":\"OK, I''ve been.\",\"startTime\":1738003305,\"endTime\":1738003306},{\"speaker\":\"8084\",\"text\":\"concerned that this will replace their roles. How you address these concerns? \",\"startTime\":1738003312,\"endTime\":1738003315},{\"speaker\":\"8084\",\"text\":\"Oh. \",\"startTime\":1738003315,\"endTime\":1738003319},{\"speaker\":\"8084\",\"text\":\"Want to hear what you say?\",\"startTime\":1738003320,\"endTime\":1738003321},{\"speaker\":\"11773\",\"text\":\"Oh well, it''s funny because.\",\"startTime\":1738003321,\"endTime\":1738003323},{\"speaker\":\"11773\",\"text\":\"We''re doing PD here today and I was given 30 minutes to help.\",\"startTime\":1738003323,\"endTime\":1738003328},{\"speaker\":\"11773\",\"text\":\"To help Stu, to help teachers in our middle school understand how AI can support them. And immediately there was some concerns that it''s just like. \",\"startTime\":1738003329,\"endTime\":1738003340},{\"speaker\":\"11773\",\"text\":\"Anyone could do this then? And like what''s like if I''m using this then I''m not \",\"startTime\":1738003342,\"endTime\":1738003345},{\"speaker\":\"11773\",\"text\":\"sort of being authentic in my? \",\"startTime\":1738003345,\"endTime\":1738003348},{\"speaker\":\"11773\",\"text\":\"Sort of teaching and student learning.\",\"startTime\":1738003349,\"endTime\":1738003352},{\"speaker\":\"11773\",\"text\":\"And I had to I.\",\"startTime\":1738003352,\"endTime\":1738003354},{\"speaker\":\"11773\",\"text\":\"I answered it with.\",\"startTime\":1738003355,\"endTime\":1738003356},{\"speaker\":\"11773\",\"text\":\"Like it still needs your amazing brains to ask it the right questions. It still \",\"startTime\":1738003357,\"endTime\":1738003361},{\"speaker\":\"11773\",\"text\":\"needs your expertise. \",\"startTime\":1738003361,\"endTime\":1738003365},{\"speaker\":\"11773\",\"text\":\"To make it produce for you so your students can benefit from its output. It \",\"startTime\":1738003367,\"endTime\":1738003374},{\"speaker\":\"11773\",\"text\":\"still needs your amazing brains to be able to inspire kids. \",\"startTime\":1738003374,\"endTime\":1738003380},{\"speaker\":\"11773\",\"text\":\"To, you know, to learn and to grow. It is it is a tool. I think it''s a fantastic \",\"startTime\":1738003381,\"endTime\":1738003385},{\"speaker\":\"11773\",\"text\":\"tool, but it is, it''s like a tool in your tool belt. \",\"startTime\":1738003385,\"endTime\":1738003390},{\"speaker\":\"11773\",\"text\":\"As you know, educators have a lot of different tools and this is one of them, but it still needs your amazing education. \",\"startTime\":1738003392,\"endTime\":1738003399},{\"speaker\":\"11773\",\"text\":\"Skills, background, experiences. You know, an experience.\",\"startTime\":1738003400,\"endTime\":1738003406},{\"speaker\":\"8084\",\"text\":\"Yeah. And I think with that, that human connection, the computers, these tools \",\"startTime\":1738003407,\"endTime\":1738003412},{\"speaker\":\"8084\",\"text\":\"will never bring the human connection that students need. We are built human \",\"startTime\":1738003412,\"endTime\":1738003416},{\"speaker\":\"8084\",\"text\":\"to connect with other humans, and we need that so desperately. And the role \",\"startTime\":1738003416,\"endTime\":1738003421},{\"speaker\":\"8084\",\"text\":\"of an educator of I may not know all of the answers, but I know a lot about learning and I know a lot about the cycles of learning and how to navigate cycles of learning, and I know how to. \",\"startTime\":1738003421,\"endTime\":1738003434},{\"speaker\":\"8084\",\"text\":\"Support productive struggle.\",\"startTime\":1738003435,\"endTime\":1738003437},{\"speaker\":\"8084\",\"text\":\"I know how to ask purposeful questions.\",\"startTime\":1738003437,\"endTime\":1738003439},{\"speaker\":\"8084\",\"text\":\"I know how to facilitate meaningful discourse. That''s not going to happen with \",\"startTime\":1738003440,\"endTime\":1738003444},{\"speaker\":\"8084\",\"text\":\"the AI tool in the human sense and our our role. \",\"startTime\":1738003444,\"endTime\":1738003449},{\"speaker\":\"11773\",\"text\":\"Yeah, yeah, yeah.\",\"startTime\":1738003447,\"endTime\":1738003449},{\"speaker\":\"8084\",\"text\":\"Especially if you''re thinking about a student who needs support on building their assistant or figuring out what their project is about. \",\"startTime\":1738003450,\"endTime\":1738003458},{\"speaker\":\"8084\",\"text\":\"We have that human connection that we can understand so much more than what their words would say. \",\"startTime\":1738003459,\"endTime\":1738003465},{\"speaker\":\"8084\",\"text\":\"But there the the communication, their Physiology, the the way that they''re giving nonverbal communication, the experiences that we''ve seen with these students before, the connections that we know about their families, the stuff that''s not in the data that''s going to be input into an AI tool. Even though it''s personalized \",\"startTime\":1738003465,\"endTime\":1738003480},{\"speaker\":\"8084\",\"text\":\"for each kid, it''s only personalized as you know, off of the data that it''s given. \",\"startTime\":1738003480,\"endTime\":1738003488},{\"speaker\":\"8084\",\"text\":\"We see so much more data than an AI tool sees, and we have much. Yeah, that''s \",\"startTime\":1738003488,\"endTime\":1738003492},{\"speaker\":\"11773\",\"text\":\"Yep, that''s a great.\",\"startTime\":1738003492,\"endTime\":1738003494},{\"speaker\":\"8084\",\"text\":\"that''s what at least makes sense in my brain today. I like this question. I \",\"startTime\":1738003492,\"endTime\":1738003496},{\"speaker\":\"8084\",\"text\":\"haven''t heard that one before. \",\"startTime\":1738003496,\"endTime\":1738003499},{\"speaker\":\"11773\",\"text\":\"North, Yeah. Yeah, that''s really good. OK.\",\"startTime\":1738003499,\"endTime\":1738003503},{\"speaker\":\"11773\",\"text\":\"Next.\",\"startTime\":1738003504,\"endTime\":1738003504},{\"speaker\":\"8084\",\"text\":\"All right. Thank you, partner. Share one thing you''ve learned from them.\",\"startTime\":1738003506,\"endTime\":1738003510},{\"speaker\":\"11773\",\"text\":\"Oh, I thank you Jeff. Appreciate this time. I love to to learn from you people \",\"startTime\":1738003514,\"endTime\":1738003520},{\"speaker\":\"11773\",\"text\":\"and and learn from amazing brains who have been in this work and. \",\"startTime\":1738003520,\"endTime\":1738003526},{\"speaker\":\"11773\",\"text\":\"I really loved about how you said that that student had gone home and basically created his own tutor. \",\"startTime\":1738003527,\"endTime\":1738003535},{\"speaker\":\"11773\",\"text\":\"That that that is really helped me. It''s like adding all of these layers that \",\"startTime\":1738003536,\"endTime\":1738003539},{\"speaker\":\"11773\",\"text\":\"we get to. \",\"startTime\":1738003539,\"endTime\":1738003543},{\"speaker\":\"11773\",\"text\":\"And that''s going to help me.\",\"startTime\":1738003544,\"endTime\":1738003545},{\"speaker\":\"11773\",\"text\":\"When I talk to teachers and some of the administrators here that have some apprehension and and concerns around. \",\"startTime\":1738003546,\"endTime\":1738003553},{\"speaker\":\"11773\",\"text\":\"You know, teachers and students using AI and that. Yeah, that''s just a.\",\"startTime\":1738003554,\"endTime\":1738003559},{\"speaker\":\"11773\",\"text\":\"A fantastic uh.\",\"startTime\":1738003560,\"endTime\":1738003561},{\"speaker\":\"11773\",\"text\":\"Connection to Mike. So thank you.\",\"startTime\":1738003562,\"endTime\":1738003564},{\"speaker\":\"8084\",\"text\":\"You''re welcome. You''re welcome. Oh, and Dale, thank you. And in particular, \",\"startTime\":1738003564,\"endTime\":1738003567},{\"speaker\":\"8084\",\"text\":\"thanks for reminding me. \",\"startTime\":1738003567,\"endTime\":1738003570},{\"speaker\":\"8084\",\"text\":\"That the AI tools even as we use them.\",\"startTime\":1738003570,\"endTime\":1738003573},{\"speaker\":\"8084\",\"text\":\"Like to build them and I end up building mine again from scratch because it doesn''t perform the way that I want my AI assisted. So I scrap it and I build \",\"startTime\":1738003574,\"endTime\":1738003581},{\"speaker\":\"8084\",\"text\":\"it again and I forget that. \",\"startTime\":1738003581,\"endTime\":1738003585},{\"speaker\":\"8084\",\"text\":\"Get better at being used and I know that wasn''t originally in the programming but now they are and so that''s something that I learned today is deaf. Remember \",\"startTime\":1738003587,\"endTime\":1738003596},{\"speaker\":\"8084\",\"text\":\"that they they they can do that and so trust it and to use it to to Polish it to make it better start with the AI assistant with. \",\"startTime\":1738003596,\"endTime\":1738003605},{\"speaker\":\"11773\",\"text\":\"Yeah.\",\"startTime\":1738003599,\"endTime\":1738003600},{\"speaker\":\"8084\",\"text\":\"As I call it that knowledge base.\",\"startTime\":1738003607,\"endTime\":1738003610},{\"speaker\":\"8084\",\"text\":\"Around the sources that I trust, the sources that we know are true use that at the beginning, but then iterate it and use to just make it better. \",\"startTime\":1738003610,\"endTime\":1738003619},{\"speaker\":\"11773\",\"text\":\"Yeah.\",\"startTime\":1738003615,\"endTime\":1738003615},{\"speaker\":\"8084\",\"text\":\"And it will get better.\",\"startTime\":1738003619,\"endTime\":1738003621},{\"speaker\":\"11773\",\"text\":\"Awesome.\",\"startTime\":1738003621,\"endTime\":1738003621},{\"speaker\":\"8084\",\"text\":\"Yeah, yeah.\",\"startTime\":1738003622,\"endTime\":1738003623},{\"speaker\":\"8084\",\"text\":\"Yeah. Thank you.\",\"startTime\":1738003624,\"endTime\":1738003625},{\"speaker\":\"8084\",\"text\":\"Alright, I''ll catch you tomorrow.\",\"startTime\":1738003626,\"endTime\":1738003627},{\"speaker\":\"11773\",\"text\":\"Thank.\",\"startTime\":1738003627,\"endTime\":1738003627},{\"speaker\":\"11773\",\"text\":\"Yes, I real quick, I will work on my presentation tonight. I''m going to share \",\"startTime\":1738003627,\"endTime\":1738003631},{\"speaker\":\"11773\",\"text\":\"it with you. \",\"startTime\":1738003631,\"endTime\":1738003635},{\"speaker\":\"8084\",\"text\":\"I saw that shared.\",\"startTime\":1738003637,\"endTime\":1738003638},{\"speaker\":\"8084\",\"text\":\"At least one of them shared.\",\"startTime\":1738003638,\"endTime\":1738003640},{\"speaker\":\"11773\",\"text\":\"Yeah. Oh, OK. Yeah, you''ve got it. I I want to tweak it a little bit more and \",\"startTime\":1738003639,\"endTime\":1738003643},{\"speaker\":\"11773\",\"text\":\"feel free to add in some pieces and maybe we could talk about that on Wednesday. \",\"startTime\":1738003643,\"endTime\":1738003646},{\"speaker\":\"8084\",\"text\":\"OK, sounds good.\",\"startTime\":1738003647,\"endTime\":1738003648},{\"speaker\":\"8084\",\"text\":\"Yeah. Oh, Dale, you''re awesome.\",\"startTime\":1738003649,\"endTime\":1738003651},{\"speaker\":\"11773\",\"text\":\"OK.\",\"startTime\":1738003649,\"endTime\":1738003650},{\"speaker\":\"11773\",\"text\":\"Thanks, Mike. You too. You too. Thank you.\",\"startTime\":1738003651,\"endTime\":1738003653},{\"speaker\":\"8084\",\"text\":\"Cheers. OK.\",\"startTime\":1738003652,\"endTime\":1738003653}]"', '2025-05-06 19:02:28.34274+00', '2025-05-06 19:02:28.34274+00', '{"type": "PAIR", "duration": 1271, "created_at": "2025-05-06T19:02:28.121Z", "session_title": "#ai_learning_tools", "knowledgeNodes": [{"id": "190", "name": "#ai_learning_tools", "tags": [{"name": "Dream Camp"}, {"name": "AI in Education"}, {"name": "Freemium"}]}], "manually_stored": true}'),
	('9c191c66-9000-4d80-8f54-c54ffdfaf6cd', 'ab5e9538-da2c-466a-9418-2acca3c546af', '134590', '"[{\"speaker\":\"11338\",\"text\":\"My name is John Malinsky, I''m a principal, and I just hope to learn more about being an effective leader for my building. \",\"startTime\":1732054314,\"endTime\":1732054324},{\"speaker\":\"11338\",\"text\":\"High in Malta, Washington.\",\"startTime\":1732054350,\"endTime\":1732054351},{\"speaker\":\"11338\",\"text\":\"En direshop.\",\"startTime\":1732054351,\"endTime\":1732054351},{\"speaker\":\"11338\",\"text\":\"To learn more about just becoming an effective leader and an effective principal and how I can support my staff and be part of the be like a servant leader, I guess is what I''m looking for. \",\"startTime\":1732054352,\"endTime\":1732054364}]"', '2025-05-06 19:02:40.255342+00', '2025-05-06 19:02:40.255342+00', '{"type": "SINGLE", "duration": 28, "created_at": "2025-05-06T19:02:40.182Z", "session_title": "Welcome to sideby!", "knowledgeNodes": [{"id": "22", "name": "Welcome to sideby!", "tags": [{"name": "Active"}, {"name": "ColumbiaSelkirk"}, {"name": "Leaders of Color"}]}], "manually_stored": true}'),
