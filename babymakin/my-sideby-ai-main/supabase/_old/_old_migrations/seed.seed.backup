	('64f9bac2-4ef1-4952-8540-74812b369744', '3d701c57-f2f7-4663-a35a-0977c34d0c7e', '4fdb1fea-74c2-4562-8eb0-d12b3608dc7d', 'Hey hey you', '2025-03-28 19:41:19.546458+00', '2025-03-28 19:41:19.546458+00', 'user', NULL),
	('6633f44b-d57d-4053-8c72-14ca12e0e36b', '49762a81-ecc9-4f18-9aaa-3c6c8b2efcd3', '713b8455-cc3b-4ab1-bcfb-255f93bf56b0', 'So sorry - I didn''t check back and get the response. Later half of next week (2-4) I have 2-2:30 on the 2nd, 3-4 on the 3rd or 4th free. Let me know (I will add a tickle on my calendar to check back on Monday', '2025-03-28 19:48:12.187633+00', '2025-03-28 19:48:12.187633+00', 'user', NULL),
	('bf6c8c24-00b5-4394-b60b-eb6dce22944b', '5fd0ea4e-a30b-427d-a54e-eb3c22941404', 'f79ffe36-4f02-4ba8-a359-b9bd8963cbd1', 'Hi MIa! Great to connect with you here. Any chance you''re free Thurs 4/3 between 1:30 - 3pm CST or Fri 4/4 8:30am - 1:30pm CST? (We''d connect for about 20 mins.)', '2025-03-28 21:33:02.530922+00', '2025-03-28 21:33:02.530922+00', 'user', NULL),
	('c21cb76f-7680-4854-bc8f-21b2585ce20d', 'c81a799c-adae-4bdb-bb4c-0f09c31a7a94', '4f2c17d9-95b8-4de7-8b97-ea6e0874f465', 'Hi Michael,  I will be on spring break next week, but am available again starting Monday, April 7.  Are there any particular times that work for you?', '2025-03-28 21:33:09.884243+00', '2025-03-28 21:33:09.884243+00', 'user', NULL),
