	('05b505e4-787b-4e99-b934-48acc75f6d0f', '75845a82-e0ba-4fcc-8a54-550f85020402', '84f08110-61a2-40fa-89bb-1b8d06e58d84', 'Hi Jeremy, do you have some time to connect next week?', '2025-03-28 16:39:11.793784+00', '2025-03-28 16:39:11.793784+00', 'user', NULL),
