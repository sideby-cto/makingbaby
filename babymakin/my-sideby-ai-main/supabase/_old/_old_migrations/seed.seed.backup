INSERT INTO "public"."profile_experiments" ("id", "user_id", "created_at", "updated_at", "suggested_hats", "stance_statement", "primary_flow_activity", "learning_focus", "teaching_focus", "analyzed_transcript", "source_type", "confidence_score", "is_second_opinion", "experiment_type", "status", "excitement_areas", "caution_areas", "moment_of_brilliance", "is_deleted", "created_by") VALUES
	('b006d77e-aec9-43d2-ab4b-33c74c61e376', '5157c388-9765-44fd-b828-6986622c5a4e', '2025-02-13 06:19:34.248528+00', '2025-02-14 20:32:51.806903+00', '{Educator,Mentor,"Curriculum Developer",Researcher}', 'Education is not just about imparting knowledge, but fostering a love for learning and developing critical thinking skills.', 'Designing and implementing innovative teaching methodologies', '{"Educational Technology","Student Engagement","Inclusion Practices"}', '{"Student-Centered Learning","Critical Thinking Skills","Inclusive Education"}', '', 'vtt_transcript', 0.85, false, 'stance_from_welcome', 'active', NULL, NULL, NULL, false, NULL),
	('aa5d3d23-ee10-4888-938d-ca0763cdeecf', 'ef31c6d4-75c1-405b-ae77-5a8d38b90562', '2025-02-13 06:24:12.053184+00', '2025-02-14 20:32:51.806903+00', '{"Curriculum Developer","Instructional Coach","STEM Facilitator"}', 'Believes in creating an interactive and student-centered learning environment that fosters critical thinking and innovation.', 'Designing project-based learning modules that integrate technology and real-world problem solving.', '{"advanced technology integration","effective assessment strategies"}', '{"project-based learning","student-centered approaches"}', '', 'vtt_transcript', 0.85, false, 'stance_from_welcome', 'active', NULL, NULL, NULL, false, NULL),
	('1b1f17b1-9b02-4b7d-ab06-77dea0552331', 'ea155ac4-eb3a-4e24-a4be-84f0143f4348', '2025-02-14 01:01:57.797683+00', '2025-02-14 20:32:51.806903+00', '{"Curriculum Developer","Educational Technology Specialist"}', 'Learner-centered with a balance of respect for standards, focusing on aligning natural interest and ability level with educational goals.', 'Teaching and integrating technology in the classroom', '{"Personalized Learning","Adaptive Technology"}', '{Mathematics,"Technology Integration"}', '[Test P.]: Hi, my name is Mike and I teach artificial intelligence mostly to teachers and leaders of teachers. I''ve taught precalculus section. I''m currently teaching  [Test P.]: precalculus at the moment.  [Test P.]: I''m teaching video production at the moment as well. Those are two courses I''m  [Test P.]: teaching at the high school level.  [Test P.]: And I hope to learn more about. [Test P.]: I hope to learn more about what students should learn now that we have tools to do some of our traditional thinking for us.  [Test P.]: So like. [Test P.]: Umm, if we ignore the concept of cheating. [Test P.]: In umm. [Test P.]: In the conversation about artificial intelligence, what becomes possible and what are the real repercussions of like skipping some steps? So like my son?  [Test P.]: Could learn how to type, but if you can just talk and that''s more natural than typing. Do I get to skip that step in his learning so that he can move on to  [Test P.]: other things? And the answer is probably yes.  [Test P.]: But yeah, I guess I wanna hear about people''s opinions. What to definitely not  [Test P.]: stuck with what to definitely not, umm, skip, etcetera.  [Test P.]: What else would I like to learn? [Test P.]: I think I''ll start with just that. [Test P.]: My stance when it comes to learning is. [Test P.]: I want to say it''s very learner centered and what I mean by that is I like to let the learner.  [Test P.]: Become curious and accelerate them towards wherever they''re curious about. [Test P.]: I am balanced by like having respect for the standards. Like those things were  [Test P.]: really thoughtful.  [Test P.]: So when we think about like my history as a math teacher, like, I don''t know everything there is to know about what every person needs to know about quantitative thinking, and people have done a really good job to write that down.  [Test P.]: Over generations and so. [Test P.]: So the teacher''s job. [Test P.]: Is to know the standards UMM and align them to natural interest and ability level.  [Test P.]: Which means starting with the line, so taking the learner from where they are to where they want to go. But.  [Test P.]: But also letting the standard play a role. [Test P.]: I''m tech forward, so I think that we should use the tools of our time. [Test P.]: Umm, and. [Test P.]: I work to help make that happen. So one of the parts of my stance is I''m ex.  [Test P.]: I''m accelerating.  [Test P.]: That piece through my work again, I teach at. [Test P.]: North Tahoe High School in. [Test P.]: Tahoe City, CA. I''m historically a math teacher. [Test P.]: And I have in the past been a curriculum and instruction coordinator, and I''ve also played various roles in technology companies.', 'vtt_transcript', 0.8, false, 'stance_from_welcome', 'active', NULL, NULL, NULL, false, NULL),
	('28551fcb-597f-416d-8be2-d86e7e98f870', 'f03cab9c-eb51-4a96-9b3f-2e39b9a3491f', '2025-02-14 03:17:43.575408+00', '2025-02-14 20:32:51.806903+00', '{"Educational Technologist","Critical Thinking Specialist"}', 'Embracing AI tools in education requires critical thinking and awareness of biases to foster authentic learning and neural pathway development.', 'Facilitating discussions on AI ethics and bias recognition', '{"Critical Thinking","Bias Awareness"}', '{"Integrating AI Tools","Promoting Authentic Learning"}', '[Scott F.]: Good. Thank you. [Scott F.]: Just testing, testing some tech out. [Jeff C.]: Good, good. [Scott F.]: The hot chocolate, by the way, is money. [Jeff C.]: Icebreaker. [Scott F.]: Yes, yes, put it. Put up my coffee each day and I have the poor guys mocha. [Scott F.]: All right, Greet your partner. Hi, Jeff. Good to see you. [Jeff C.]: Hi, Mike. I mean Scott. [Scott F.]: Thank you. There you go. [Scott F.]: Umm, let''s see here. Share your first experience. Do we have to go through this  [Scott F.]: all the way or are we good now or?  [Jeff C.]: Let''s try it out. It''s the data. Yeah, Well, I''m also curious, what''s your,  [Scott F.]: Let''s go through it, OK? [Jeff C.]: what''s your first?  [Scott F.]: Oh jeez, first experience using that. First I remember it was. I''ll never forget  [Scott F.]: it.  [Scott F.]: Is up at 4 points Sheraton in the Seatac area and I was screwing around and I made songs out of the.  [Scott F.]: Snoop Dogg genre and then I would change the song up into a cowboy style. Then  [Scott F.]: I did some poems and and and.  [Scott F.]: Used my friend''s dog''s name and his and he was just a puppy being a pain in the ass. So I made some. I just, I was, I was creating songs.  [Scott F.]: And changing the changing the genre up, up. And it was so damn funny. This all  [Scott F.]: the differences, it was so funny.  [Scott F.]: Yeah, yeah. That was like March or April a couple years ago actually. [Jeff C.]: That''s awesome. That''s awesome. [Jeff C.]: Oh I like it, I had some similar experience doing like generating some music but I don''t know how AI was built or just some programming so I''m not going to use that as my first one.  [Jeff C.]: I remember some things along the way, but the one that really got me was. [Jeff C.]: I was so excited because I''ve been reading and and listening to and watching podcasts and videos about AI and what it can do and then finally Chat CBT comes out and I, I''m like OK ChatGPT.  [Scott F.]: Yeah, yeah. [Jeff C.]: I''ve been organizing my Google Drive with all of this cool stuff and I''ve had all of these parts and pieces and I know it needs better organized and I want to synthesize it all together. Here we go.  [Jeff C.]: And it wasn''t ready at all to do that today. I could do that ''cause I can connect  [Jeff C.]: it. And then even in Google Drive, you can summarize that it''s built in, summarize  [Scott F.]: Yeah, right. [Jeff C.]: this folder. Or I''m like, I''ve been wanting. I''ve tried to do that before. I  [Jeff C.]: saw that on my Google Drive page, by the way, look on yours, like just pause for a second next time, like up in the top of my ass book.  [Scott F.]: Yeah, eat it. [Scott F.]: I''m, I''m writing. Really. I''m writing that down. OK, good. Yeah, ''cause my Google  [Scott F.]: Drive''s a mess.  [Jeff C.]: So I, I asked, and then there was another one like, hey, here are some sample lessons. And here''s a sample structure with a teacher guide. Let''s make some  [Jeff C.]: more ones for this. And I was like, I wanted to spit out a whole unit and it  [Jeff C.]: was no, it wasn''t ready for it. No, no.  [Scott F.]: What was ready for that? Yeah, yeah. [Jeff C.]: So I was I was reading too much and had been in theory headspace too much and didn''t meet.  [Jeff C.]: Where the tools were functional, yet it was like, I want to drive a car 80,000 miles an hour. Well, Jeff, we can''t. Yeah, yes.  [Scott F.]: Right. Got it. [Scott F.]: Here here ya. [Jeff C.]: All right. [Jeff C.]: Oh, share your thoughts on real fears versus misplaced fears about using AI tools in education. Then ask your partner to add to your answer. Does yours  [Jeff C.]: say share or does it say listen to Jeff or something?  [Scott F.]: Mine says ask your partner. [Jeff C.]: OK. [Scott F.]: So what do you think are some fears, real fears versus misplaced fears about using AI tools in education?  [Jeff C.]: I think one, that it''s going to replace us. There''s we''re just going to have  [Jeff C.]: a bunch of robots in the classroom.  [Scott F.]: Yeah. [Jeff C.]: I won''t. I won''t have a job. [Jeff C.]: It''s going to take over the world. [Scott F.]: Right. [Jeff C.]: Gonna read all of my thoughts. [Jeff C.]: Yeah, all of those kind of things. Those are my first ones. [Jeff C.]: About versus thoughts on real fears versus misplaced fears, I think real fears are.  [Scott F.]: Versus misplaced fears. [Jeff C.]: Will I use the tool effectively in the way that I want to and still keep my own identity and use it to create my own identity the way I want to craft my the way I see myself and who I want to be? Or will I just get inundated with  [Jeff C.]: so much information and so many I could use this tools that I no longer have my own?  [Scott F.]: Right. [Jeff C.]: Identity and agency in it, but I''m more reacting to all of the. [Jeff C.]: Pop ups and the bells and whistles and the Jeff do this and Jeff do that and answer the e-mail and do this thing because I''m responding and I''m a reactionary individual rather than the one at the control of my life and and using the tools.  [Scott F.]: Yeah, right. [Jeff C.]: So I guess in the one way to say it.  [Scott F.]: Yeah. [Jeff C.]: Stealing this from Matthew Green, who''s doing the programming? Am I programming  [Jeff C.]: it or is it programming me? Yeah.  [Scott F.]: Programming you yeah, yeah, You know, I was just thinking about that as you were talking like some of the the real fears of.  [Scott F.]: Priority see massive isolation among kids and teenagers and depression and anxiety and diminished mental health and.  [Scott F.]: And is this. [Jeff C.]: I think your phone''s ringing or something. I can''t hear you. [Jeff C.]: I still can''t hear you. I lost your your audio. [Jeff C.]: Can you hear my audio? [Scott F.]: OK, still there. [Jeff C.]: I''m here. That was really interesting just for feedback when it started ringing  [Jeff C.]: your phone, I it cut out your audio so you were saying something so I didn''t catch that and then.  [Jeff C.]: When you''re done with the call. I''m guessing now, now that I can hear you. [Scott F.]: Then it came back so it it shut my audio off to you. [Scott F.]: OK. And there there is like the the. [Scott F.]: I call it the hamburger, like up top where it says guts and fear and AI. [Jeff C.]: Mm-hmm. Yeah. Oh yeah. Yeah. Yeah. [Scott F.]: The hamburger there, you press that and it has something there. Restart audio  [Scott F.]: and video.  [Scott F.]: So like, if I, if we''re missing something, we could do that. But anyway, so  [Scott F.]: the let''s talk about just just that that, that that isolation is going to lead to more lack of lack of communication among people, lack of, of whatever it is, you know, is, is AI gonna replace and not replace friends or anything like that, but maybe.  [Jeff C.]: Oh cool. [Jeff C.]: Yeah, tell me more. Your depression? No. [Scott F.]: You know, do I, do I really need to engage in, in community and society as a whole as a, as a kid?  [Scott F.]: And then how does that lead to education, you know, Anyway, just a few things around that and and.  [Scott F.]: You know some of the fears. [Scott F.]: Whether placed reality or misplaced fears is. [Scott F.]: The authenticity of learning you know how how are how are how are kids. [Scott F.]: Going to build learning pathways in their minds. [Scott F.]: If if they''re like are the Synapse is going to get connected? I don''t know if  [Scott F.]: 