	('d8e9db8f-f716-4f11-9fb9-c204d951fd7d', 'Katie', 'Stahl', 'Cheesehead by birth, currently a Hoosier.  Wife, mom of two boys (14 & 3), and fostering a teen girl.  Former collegiate softball player and coach.  Scout mom/leader (I used to be a bear).', 'Finishing my 20th year (24-25) in HS in a suburb of Indianapolis.  3rd largest district in the state in a large HS with ~3,500 kids.  Taught most things social studies (US History, World History, Geography, Psychology, Government etc).  Current assignments are Geography & History of the World (Cultural Geography), World History, and Sheltered ENL (ELL/ESL) US History.  Semi-fluent in Spanish and learning more everyday.  ', '{"US History",Government,Geography,"World History","English as a New Language (ENL)",Pscyhology,Spanish}', '{}', 'https://upffcxqiozqhdgfesmji.supabase.co/storage/v1/object/public/avatars/d8e9db8f-f716-4f11-9fb9-c204d951fd7d-0.08808105338564953.JPG', '2025-03-19 13:08:19.558135+00', '2025-05-06 16:39:59.583919+00', '{"{\"name\": \"Social Studies Teacher\", \"status\": \"active\"}","{\"name\": \"ENL Co-Teacher\", \"status\": \"active\"}","{\"name\": \"High School\", \"status\": \"active\"}","{\"name\": \"Mom of 2 boys, foster girl mom\", \"status\": \"active\"}"}', 'kstahl@hse.k12.in.us', '{"chat_notifications": true}', NULL, NULL, 'active', NULL, true, '+13174092417', '{"sms": true, "email": true, "in_app": true}', true, NULL, '2025-04-30 17:33:33.259+00', NULL, true, NULL, NULL),
